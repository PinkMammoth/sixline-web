---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/sections/PageHeader.astro';
import PricingCard from '~/components/ui/PricingCard.astro';
import SectionHeading from '~/components/ui/SectionHeading.astro';
import Faq from '~/components/ui/Faq.astro';
import { faq } from '~/data/faq';
import { formatPrice, pricing } from '~/data/site';

const pricingFaq = faq.filter((f) => ['free', 'lifetime', 'updates', 'pay-again', 'trial-end'].includes(f.id));
const steps = [
  {
    label: 'Try',
    title: 'Start with the free trial',
    body: 'Every feature is unlocked during the trial, for a limited time. The trial length will be published before the beta launches.',
  },
  {
    label: 'Buy once',
    title: `Founder’s Beta — ${formatPrice(pricing.beta.price)}`,
    body: 'One payment during the public beta gets you a lifetime licence. No account tiers, no add-ons.',
  },
  {
    label: 'Keep updating',
    title: 'Every future version included',
    body: `When v1.0 arrives, the planned price for new customers rises to ${formatPrice(pricing.v1.price)}. You keep your licence and every update after it.`,
  },
];
---

<BaseLayout
  title="Pricing"
  description={`Planned pricing: a one-time ${formatPrice(pricing.beta.price)} Founder’s Beta licence with every future update included. No subscriptions, no paid upgrades.`}
>
  <PageHeader eyebrow="Pricing" title="One price. Every future update.">
    <p>
      SixLine is a one-time purchase. No subscription, no paid upgrades, no feature tiers. Pricing below is planned and
      will apply when the public beta opens.
    </p>
  </PageHeader>

  <section class="section-y" aria-label="Lifetime licence">
    <div class="container-content">
      <PricingCard headingLevel="h2" />
    </div>
  </section>

  <section class="section-y border-t border-line-subtle" aria-labelledby="how-title">
    <div class="container-content">
      <SectionHeading id="how-title" eyebrow="How it works" title="Try it, buy it once, keep it." />
      <ol class="mt-12 grid gap-px overflow-hidden rounded-xl border border-line-subtle bg-line-subtle md:grid-cols-3">
        {
          steps.map((s, i) => (
            <li class="bg-bg p-6 sm:p-8" data-reveal>
              <p class="label-mono text-fg-muted">
                <span class="text-accent-text">0{i + 1}</span> — {s.label}
              </p>
              <h3 class="mt-4 text-h4 text-fg">{s.title}</h3>
              <p class="mt-3 text-sm text-fg-secondary">{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section-y bg-surface-1" aria-labelledby="pricing-faq-title">
    <div class="container-content grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <SectionHeading id="pricing-faq-title" eyebrow="Questions" title="About the licence." />
      </div>
      <div class="lg:col-span-8">
        <Faq items={pricingFaq} />
        <p class="mt-8 text-sm text-fg-muted">
          Refund terms will be published before checkout opens. Prices are in US dollars; applicable taxes may be added at
          checkout.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
