---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/ui/PageHeader.astro';
import PricingCard from '~/components/ui/PricingCard.astro';
import Eyebrow from '~/components/ui/Eyebrow.astro';
import Faq from '~/components/ui/Faq.astro';
import { faq } from '~/data/faq';
import { formatPrice, pricing } from '~/data/site';

const pricingFaq = faq.filter((f) => ['free', 'lifetime', 'updates', 'pay-again', 'trial-end'].includes(f.id));
const steps = [
  {
    label: 'Try',
    title: 'Start with the free trial',
    body: `A full-featured ${pricing.trialDays}-day trial is planned for the commercial beta. When it ends, your projects stay openable and viewable; editing, saving changes and exporting need a licence.`,
  },
  {
    label: 'Buy once',
    title: `Founder’s Beta — ${formatPrice(pricing.beta.price)}`,
    body: 'One payment during the public beta gets you a lifetime licence. No account tiers, no add-ons.',
  },
  {
    label: 'Keep updating',
    title: 'Every future version included',
    body: `When v1.0 arrives, the planned price for new customers rises to ${formatPrice(pricing.v1.price)}. You keep your licence and every update after it.`,
  },
];
---

<BaseLayout
  title="Pricing"
  description={`Planned pricing: a one-time ${formatPrice(pricing.beta.price)} Founder’s Beta licence with every future update included. No subscriptions, no paid upgrades.`}
>
  <PageHeader eyebrow="Pricing" title="One price.<br />Every future update.">
    <p>
      SixLine is a one-time purchase — no subscription, no paid upgrades, no feature tiers. The pricing below is planned, and
      applies when the public beta opens.
    </p>
  </PageHeader>

  <section class="paper grain section-y" aria-label="Lifetime licence">
    <div class="container-content">
      <PricingCard headingLevel="h2" />
    </div>
  </section>

  <section class="grain section-y bg-warm-1" aria-labelledby="how-title">
    <div class="container-content">
      <Eyebrow>How it works</Eyebrow>
      <h2 id="how-title" class="mt-7 text-h2 tracking-display text-fg">Try it, buy it once, keep it.</h2>
      <ol class="mt-14 grid grid-cols-1 gap-10 md:grid-cols-3 md:gap-8">
        {
          steps.map((s, i) => (
            <li class="border-t border-line pt-7" data-reveal style={`--reveal-delay:${i * 90}ms`}>
              <p class="font-display text-h2 tracking-display text-accent-text">0{i + 1}</p>
              <p class="label-mono mt-5 text-fg-muted">{s.label}</p>
              <h3 class="mt-2 text-h4 text-fg">{s.title}</h3>
              <p class="mt-3 text-sm text-fg-secondary">{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section-y" aria-labelledby="pricing-faq-title">
    <div class="container-content grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-4">
        <Eyebrow>Questions</Eyebrow>
        <h2 id="pricing-faq-title" class="mt-7 text-h2 tracking-display text-fg">About the licence.</h2>
      </div>
      <div class="lg:col-span-8">
        <Faq items={pricingFaq} />
        <p class="mt-8 text-sm text-fg-muted">
          Refund terms will be published before checkout opens. Prices are in US dollars; applicable taxes may be added at
          checkout.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
