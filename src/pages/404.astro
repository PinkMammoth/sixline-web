---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Button from '~/components/ui/Button.astro';
import Logo from '~/components/brand/Logo.astro';
---

<BaseLayout title="Page not found" noindex>
  <section class="grain section-y">
    <div class="container-content max-w-xl text-center">
      <Logo variant="symbol" height={72} label="" class="mx-auto text-fg" />
      <p class="label-mono mt-10 text-fg-muted">404</p>
      <h1 class="mt-4 text-h1 tracking-display text-fg">This page is a rest.</h1>
      <p class="mt-5 text-fg-secondary">The page you were looking for doesn’t exist or has moved.</p>
      <div class="mt-9 flex justify-center">
        <Button href="/" variant="secondary">Back to home</Button>
      </div>
    </div>
  </section>
</BaseLayout>
