---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/ui/PageHeader.astro';
import Eyebrow from '~/components/ui/Eyebrow.astro';
import Closing from '~/components/home/Closing.astro';
import { availableFeatures, confirmedFormats, groupMeta, trademarkNotice, workbenchFeatures, type FeatureGroup } from '~/data/features';

const groups: FeatureGroup[] = ['writing', 'playback', 'compatibility'];
const bench = workbenchFeatures();
---

<BaseLayout
  title="Features"
  description="Tablature and notation editing, multi-track composition, playback, Guitar Pro import and MIDI — plus an honest list of what’s still on the workbench."
>
  <PageHeader eyebrow="Features" title="Built for writing, hearing and playing music.">
    <p>
      Everything listed here works in the current development build. Features still being checked are kept separately, on the{' '}
      <a href="#workbench" class="link-quiet text-fg">workbench</a>, until we can promise them.
    </p>
  </PageHeader>

  {
    groups.map((group, i) => (
      <section class:list={['grain section-y', i === 1 && 'bg-warm-1']} aria-labelledby={`group-${group}`}>
        <div class="container-content grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-12">
          <div class="lg:col-span-5" data-reveal>
            <Eyebrow index={`0${i + 1}`}>{groupMeta[group].label}</Eyebrow>
            <h2 id={`group-${group}`} class="mt-7 text-h2 tracking-display text-fg">
              {groupMeta[group].title}
            </h2>
            <p class="mt-6 max-w-md text-lead text-fg-secondary">{groupMeta[group].intro}</p>
          </div>
          <div class="lg:col-span-6 lg:col-start-7" data-reveal style="--reveal-delay:100ms">
            <ul class="border-t border-line">
              {availableFeatures(group).map((f) => (
                <li class="border-b border-line py-7">
                  <h3 class="text-h3 text-fg">{f.title}</h3>
                  <p class="mt-2 text-fg-secondary">{f.description}</p>
                </li>
              ))}
            </ul>
            {group === 'compatibility' && (
              <p class="mt-6 text-sm text-fg-muted">
                Formats: {confirmedFormats.map((f) => `${f.name} (${f.direction.toLowerCase()})`).join(', ')}. {trademarkNotice}
              </p>
            )}
          </div>
        </div>
      </section>
    ))
  }

  <section id="workbench" class="paper grain section-y" aria-labelledby="workbench-title">
    <div class="container-content">
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:items-end" data-reveal>
        <div class="lg:col-span-7">
          <Eyebrow>On the workbench</Eyebrow>
          <h2 id="workbench-title" class="mt-7 text-h1 tracking-display text-fg">Being checked before we promise it.</h2>
        </div>
        <p class="text-lead text-fg-secondary lg:col-span-5 lg:pb-2">
          We only list a feature as part of SixLine once it’s been verified in the app. These are being checked now, and each one
          will be confirmed — or clearly marked as planned — before the public beta.
        </p>
      </div>

      <ul class="mt-14 grid grid-cols-1 gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-3" data-reveal>
        {
          bench.map((f) => (
            <li class="flex flex-col gap-3 bg-surface-1 p-6 sm:p-7">
              <p class="label-mono text-fg-muted">{groupMeta[f.group].label}</p>
              <h3 class="text-h4 text-fg">{f.title}</h3>
              <p class="text-sm text-fg-secondary">{f.description}</p>
            </li>
          ))
        }
        <li class="flex flex-col gap-3 bg-surface-1 p-6 sm:p-7">
          <p class="label-mono text-fg-muted">{groupMeta.compatibility.label}</p>
          <h3 class="text-h4 text-fg">File format details</h3>
          <p class="text-sm text-fg-secondary">Supported Guitar Pro versions (GP3, GP4, GP5), MIDI import and export, and the native project format.</p>
        </li>
        {(bench.length + 1) % 2 === 1 && <li class="hidden bg-surface-1 sm:block lg:hidden" aria-hidden="true" />}
      </ul>
    </div>
  </section>

  <Closing title="Start with a riff." />
</BaseLayout>
