---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/ui/PageHeader.astro';
import Eyebrow from '~/components/ui/Eyebrow.astro';
import Closing from '~/components/home/Closing.astro';
import { availableFeatures, pillarMeta, previewFeatures, trademarkNotice, unverifiedFeatures, type FeaturePillar } from '~/data/features';

const pillars: { id: FeaturePillar; href: string; cta: string }[] = [
  { id: 'practice', href: '/practice', cta: 'How practice works' },
  { id: 'create', href: '/create', cta: 'Explore Create' },
];
const previews = previewFeatures('practice');
const unverified = unverifiedFeatures();
---

<BaseLayout
  title="All features"
  description="Every SixLine feature in one place: what's available now, what's coming before launch, and what's still being verified."
>
  <PageHeader eyebrow="All features" title="Learn it. Master it.<br />Make it yours.">
    <p>
      Everything SixLine can do today, plus an honest list of what’s{' '}
      <a href="#coming" class="link-quiet text-fg">coming before launch</a> and what’s still{' '}
      <a href="#verifying" class="link-quiet text-fg">being verified</a>.
    </p>
  </PageHeader>

  <section class="grain section-y" aria-label="Available now">
    <div class="container-content grid grid-cols-1 gap-16 lg:grid-cols-2 lg:gap-12">
      {
        pillars.map((p, i) => (
          <div data-reveal style={`--reveal-delay:${i * 100}ms`}>
            <Eyebrow index={`0${i + 1}`}>{pillarMeta[p.id].label} · available now</Eyebrow>
            <h2 class="mt-7 text-h2 tracking-display text-fg" set:html={pillarMeta[p.id].title} />
            <ul class="mt-10 border-t border-line">
              {availableFeatures(p.id).map((f) => (
                <li class="border-b border-line py-5">
                  <h3 class="text-h4 text-fg">{f.title}</h3>
                  <p class="mt-1.5 text-sm text-fg-secondary">{f.description}</p>
                </li>
              ))}
            </ul>
            <a href={p.href} class="mt-6 inline-block text-sm font-medium text-fg">
              <span class="link-quiet">{p.cta}</span> <span aria-hidden="true">→</span>
            </a>
          </div>
        ))
      }
    </div>
    <p class="container-content mt-10 text-[0.8125rem] text-fg-muted">{trademarkNotice}</p>
  </section>

  <section id="coming" class="grain section-y bg-warm-1" aria-labelledby="coming-title">
    <div class="container-content grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-5" data-reveal>
        <Eyebrow>Coming before launch</Eyebrow>
        <h2 id="coming-title" class="mt-7 text-h2 tracking-display text-fg">Launch previews.</h2>
        <p class="mt-6 max-w-md text-lead text-fg-secondary">
          Committed for launch, but not built and tested yet. We’ll only describe them as available once they are.
        </p>
      </div>
      <ul class="space-y-3 lg:col-span-6 lg:col-start-7" data-reveal style="--reveal-delay:100ms">
        {
          previews.map((f) => (
            <li class="rounded-xl border border-dashed border-line p-6">
              <p class="label-mono text-[0.6875rem] text-accent-text">Launch preview · not available yet</p>
              <h3 class="mt-2 text-h4 text-fg">{f.title}</h3>
              <p class="mt-1.5 text-sm text-fg-secondary">{f.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="verifying" class="paper grain section-y" aria-labelledby="verifying-title">
    <div class="container-content grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-5" data-reveal>
        <Eyebrow>Being verified</Eyebrow>
        <h2 id="verifying-title" class="mt-7 text-h2 tracking-display text-fg">Checked before we promise it.</h2>
        <p class="mt-6 max-w-md text-lead text-fg-secondary">
          These have been reported but aren’t yet verified against the app, so we don’t advertise them.
        </p>
      </div>
      <ul class="grid grid-cols-1 gap-px overflow-hidden rounded-xl border border-line bg-line lg:col-span-6 lg:col-start-7" data-reveal>
        {
          unverified.map((f) => (
            <li class="bg-surface-1 p-6">
              <p class="label-mono text-fg-muted">{pillarMeta[f.pillar].label}</p>
              <h3 class="mt-2 text-h4 text-fg">{f.title}</h3>
              <p class="mt-1.5 text-sm text-fg-secondary">{f.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Closing title="Pick a passage. Start practising." primary={{ label: 'See how practice works', href: '/practice' }} />
</BaseLayout>
