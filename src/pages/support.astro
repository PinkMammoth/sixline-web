---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/ui/PageHeader.astro';
import Eyebrow from '~/components/ui/Eyebrow.astro';
import Faq from '~/components/ui/Faq.astro';
import { faq } from '~/data/faq';
import { contact } from '~/data/site';

const cards = [
  {
    title: 'Contact',
    body: contact.supportEmail ? null : 'A support address will be published here before the public beta.',
  },
  { title: 'Documentation', body: 'Getting-started guides and reference documentation are being written.' },
  { title: 'Bugs and ideas', body: 'Beta feedback channels will open with the first public build.' },
];
---

<BaseLayout title="Support" description="Get help with SixLine: contact details, FAQs and documentation.">
  <PageHeader eyebrow="Support" title="Here to help.">
    <p>SixLine is independent software. Support channels open alongside the public beta — until then, here’s what to expect.</p>
  </PageHeader>

  <section class="paper grain section-y" aria-label="Contact and resources">
    <div class="container-content grid grid-cols-1 gap-6 md:grid-cols-3">
      {
        cards.map((c, i) => (
          <article class="flex flex-col rounded-2xl border border-line bg-surface-2 p-7 shadow-panel sm:p-8">
            <p class="font-mono text-sm text-accent-text">0{i + 1}</p>
            <h2 class="mt-8 text-h3 text-fg">{c.title}</h2>
            {c.body ? (
              <p class="mt-3 text-sm text-fg-secondary">{c.body}</p>
            ) : (
              <p class="mt-3 text-sm text-fg-secondary">
                Email{' '}
                <a class="link-quiet text-fg" href={`mailto:${contact.supportEmail}`}>
                  {contact.supportEmail}
                </a>
              </p>
            )}
          </article>
        ))
      }
    </div>
  </section>

  <section class="section-y" aria-labelledby="support-faq">
    <div class="container-content grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-4">
        <Eyebrow>FAQ</Eyebrow>
        <h2 id="support-faq" class="mt-7 text-h2 tracking-display text-fg">Common questions.</h2>
      </div>
      <div class="lg:col-span-8">
        <Faq items={faq} />
        <p class="mt-10 text-sm text-fg-muted">
          Privacy policy, terms and refund information will be published before checkout opens.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
