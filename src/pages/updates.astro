---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/ui/PageHeader.astro';
import Eyebrow from '~/components/ui/Eyebrow.astro';
import Logbook from '~/components/ui/Logbook.astro';
import { development } from '~/data/development';
import { getReleases, formatDate } from '~/data/releases';
import { render } from 'astro:content';

const releases = await getReleases();
const rendered = await Promise.all(releases.map(async (r) => ({ entry: r, Content: (await render(r)).Content })));
---

<BaseLayout title="Updates" description="SixLine development updates and release notes.">
  <PageHeader eyebrow="Updates" title="Always getting better.">
    <p>{development.summary} Every public release — what changed, and what isn’t finished yet — will be written up here.</p>
  </PageHeader>

  <section class="grain section-y bg-warm-1" aria-labelledby="status-title">
    <div class="container-content grid grid-cols-1 gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <Eyebrow>Where things stand</Eyebrow>
        <h2 id="status-title" class="mt-7 text-h2 tracking-display text-fg">The road to the beta.</h2>
      </div>
      <div class="lg:col-span-7 lg:col-start-6">
        <Logbook />
      </div>
    </div>
  </section>

  <section class="paper grain section-y" aria-labelledby="history-title">
    <div class="container-content">
      <Eyebrow>Release notes</Eyebrow>
      <h2 id="history-title" class="mt-7 text-h2 tracking-display text-fg">Release history.</h2>
      {
        rendered.length ? (
          <ol class="mt-12 border-t border-line">
            {rendered.map(({ entry, Content }) => (
              <li class="grid grid-cols-1 gap-6 border-b border-line py-10 md:grid-cols-12" id={`v${entry.data.version}`}>
                <div class="md:col-span-4">
                  <h3 class="font-mono text-h4 text-fg">{entry.data.version}</h3>
                  <p class="label-mono mt-2 text-fg-muted">
                    <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time> · {entry.data.channel}
                  </p>
                </div>
                <div class="release-notes text-fg-secondary md:col-span-8">
                  <p class="text-lead text-fg">{entry.data.summary}</p>
                  <Content />
                </div>
              </li>
            ))}
          </ol>
        ) : (
          <div class="mt-12 border-y border-line py-14">
            <p class="max-w-xl font-display text-h3 text-fg">The first entry will be the public beta.</p>
            <p class="mt-3 max-w-xl text-fg-secondary">
              No public release has shipped yet. When it does, its notes and known limitations will appear here first.
            </p>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .release-notes :global(h3) {
    margin-top: 1.75rem;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--text-label--letter-spacing);
    text-transform: uppercase;
    color: var(--sl-text-muted);
  }
  .release-notes :global(ul) {
    margin-top: 0.75rem;
    list-style: disc;
    padding-left: 1.25rem;
  }
  .release-notes :global(li + li) {
    margin-top: 0.375rem;
  }
</style>
