---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/ui/PageHeader.astro';
import DownloadCard from '~/components/ui/DownloadCard.astro';
import { actions, pricing, site } from '~/data/site';
---

<BaseLayout
  title="Download"
  description="Download SixLine for Windows. Downloads open with the commercial beta; a macOS version is planned."
>
  <PageHeader eyebrow="Download" title="Windows first.<br />macOS planned.">
    <p>
      SixLine’s Windows installers have been built and tested. Downloads will open here with the commercial beta, once
      licensing and the planned {pricing.trialDays}-day free trial are in place. A macOS version is planned.
    </p>
  </PageHeader>

  <section class="paper grain section-y" aria-label="Platforms">
    <div class="container-content">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        <DownloadCard platform="Windows" href={actions.downloads.windows} version={site.appVersion} status="With the beta" />
        <DownloadCard platform="macOS" href={actions.downloads.macos} version={site.appVersion} status="Planned" />
      </div>

      <div class="mt-16 grid grid-cols-1 gap-10 border-t border-line pt-12 md:grid-cols-3">
        <div>
          <h2 class="text-h4 text-fg">About the free trial</h2>
          <p class="mt-3 text-sm text-fg-secondary">
            A full-featured {pricing.trialDays}-day trial is planned. When it ends, your projects stay openable and viewable; editing, saving changes and exporting need a licence.
          </p>
        </div>
        <div>
          <h2 class="text-h4 text-fg">Buy once, whenever you’re ready</h2>
          <p class="mt-3 text-sm text-fg-secondary">
            A lifetime licence with every future update. <a href="/pricing" class="link-quiet text-fg">See pricing</a>.
          </p>
        </div>
        <div>
          <h2 class="text-h4 text-fg">Release notes</h2>
          <p class="mt-3 text-sm text-fg-secondary">
            Each build will come with release notes and a list of known limitations.{' '}
            <a href="/updates" class="link-quiet text-fg">View updates</a>.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
