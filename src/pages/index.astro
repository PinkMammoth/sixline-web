---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Button from '~/components/ui/Button.astro';
import StatusLabel from '~/components/ui/StatusLabel.astro';
import ProductFrame from '~/components/ui/ProductFrame.astro';
import MediaSlot from '~/components/ui/MediaSlot.astro';
import SectionHeading from '~/components/ui/SectionHeading.astro';
import FeatureList from '~/components/ui/FeatureList.astro';
import TabStaff from '~/components/ui/TabStaff.astro';
import PricingCard from '~/components/ui/PricingCard.astro';
import DevStatus from '~/components/ui/DevStatus.astro';
import Faq from '~/components/ui/Faq.astro';
import CtaSection from '~/components/sections/CtaSection.astro';
import { actions, trialHref } from '~/data/site';
import { featuresByGroup, formats, groupMeta, trademarkNotice } from '~/data/features';
import { faq } from '~/data/faq';
---

<BaseLayout>
  <!-- B. Hero -->
  <section class="pt-12 pb-16 sm:pt-20 lg:pt-24 lg:pb-24" aria-labelledby="hero-title">
    <div class="container-wide">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:items-end lg:gap-12">
        <div class="min-w-0 lg:col-span-7">
          <StatusLabel status="pre-launch" label="In development · Beta coming soon" />
          <h1 id="hero-title" class="mt-7 max-w-[14ch] text-h1 text-fg">Your music. Your way of writing it.</h1>
        </div>
        <div class="lg:col-span-5 lg:pb-1.5">
          <p class="text-lead text-fg-secondary">
            A modern tablature editor built for musicians who create, practise and play.
          </p>
          <p class="mt-5 border-l-2 border-accent pl-4 font-display text-h4 font-medium text-fg">
            No subscriptions. No paid upgrades. Just music.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <Button href={trialHref} pending="Coming soon">Try SixLine free</Button>
            <Button href={actions.checkoutUrl} variant="secondary" pending="Coming soon">Get lifetime access</Button>
          </div>
        </div>
      </div>

      <ProductFrame
        class="mt-14 lg:mt-20"
        priority
        title="SixLine"
        placeholderLabel="Real SixLine application screenshot"
      />
    </div>
  </section>

  <!-- C. Writing and composition -->
  <section id="writing" class="section-y border-t border-line-subtle" aria-labelledby="writing-title">
    <div class="container-content grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5" data-reveal>
        <SectionHeading id="writing-title" eyebrow={`01 — ${groupMeta.writing.label}`} title={groupMeta.writing.title}>
          <p>{groupMeta.writing.intro}</p>
        </SectionHeading>
        <div class="mt-10"><FeatureList features={featuresByGroup('writing')} /></div>
      </div>
      <div class="lg:col-span-7 lg:pt-2" data-reveal>
        <div class="lg:sticky lg:top-24">
          <MediaSlot label="Writing a riff and building it into a multi-track arrangement" />
        </div>
      </div>
    </div>
  </section>

  <!-- D. Playback and practice -->
  <section id="playback" class="section-y bg-surface-1 [--staff-bg:var(--sl-surface-1)]" aria-labelledby="playback-title">
    <div class="container-content">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:items-end lg:gap-16" data-reveal>
        <SectionHeading
          class="lg:col-span-6"
          id="playback-title"
          eyebrow={`02 — ${groupMeta.playback.label}`}
          title={groupMeta.playback.title}
        >
          <p>{groupMeta.playback.intro}</p>
        </SectionHeading>
        <TabStaff class="lg:col-span-6" />
      </div>
      <div class="mt-14" data-reveal>
        <FeatureList features={featuresByGroup('playback')} layout="grid" />
      </div>
    </div>
  </section>

  <!-- E. Compatibility and workflow -->
  <section id="compatibility" class="section-y" aria-labelledby="compat-title">
    <div class="container-content grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5" data-reveal>
        <SectionHeading id="compat-title" eyebrow={`03 — ${groupMeta.compatibility.label}`} title={groupMeta.compatibility.title}>
          <p>{groupMeta.compatibility.intro}</p>
        </SectionHeading>
      </div>
      <div class="lg:col-span-7" data-reveal>
        <div class="overflow-x-auto rounded-lg border border-line-subtle" tabindex="0" role="region" aria-label="File format support">
          <table class="w-full min-w-[30rem] text-left text-sm">
            <caption class="sr-only">File formats and their support status</caption>
            <thead class="bg-surface-1">
              <tr>
                <th scope="col" class="label-mono px-4 py-3 font-medium text-fg-muted sm:px-5">Format</th>
                <th scope="col" class="label-mono px-4 py-3 font-medium text-fg-muted">Direction</th>
                <th scope="col" class="label-mono px-4 py-3 font-medium text-fg-muted sm:px-5">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-line-subtle">
              {
                formats.map((f) => (
                  <tr>
                    <th scope="row" class="px-4 py-4 font-normal sm:px-5">
                      <span class="font-mono text-fg">{f.format}</span>
                      <span class="ml-2 text-fg-muted">{f.detail}</span>
                    </th>
                    <td class="px-4 py-4 text-fg-secondary">{f.direction}</td>
                    <td class="px-4 py-4 sm:px-5">
                      <StatusLabel status={f.status} />
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="mt-5 text-[0.8125rem] text-fg-muted">{trademarkNotice}</p>
      </div>
    </div>
  </section>

  <!-- F. Pricing -->
  <section id="pricing" class="section-y border-t border-line-subtle" aria-labelledby="pricing-title">
    <div class="container-content">
      <div data-reveal>
        <SectionHeading id="pricing-title" eyebrow="04 — Pricing" title="Pay once. Keep every update.">
          <p>One licence, every future version. No subscription, no upgrade fees, no tiers.</p>
        </SectionHeading>
      </div>
      <div class="mt-12" data-reveal>
        <PricingCard />
        <p class="mt-6 text-sm">
          <a href="/pricing" class="link-quiet text-fg-secondary">How the licence and free trial work <span aria-hidden="true">→</span></a>
        </p>
      </div>
    </div>
  </section>

  <!-- G. Development and transparency -->
  <section id="development" class="section-y bg-surface-1" aria-labelledby="dev-title">
    <div class="container-content grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4" data-reveal>
        <SectionHeading id="dev-title" eyebrow="05 — Development" title="Built in the open.">
          <p>Where SixLine is, what changed recently and what comes next.</p>
        </SectionHeading>
      </div>
      <div class="lg:col-span-8" data-reveal>
        <DevStatus />
      </div>
    </div>
  </section>

  <!-- H. FAQ -->
  <section id="faq" class="section-y" aria-labelledby="faq-title">
    <div class="container-content grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4" data-reveal>
        <SectionHeading id="faq-title" eyebrow="06 — Questions" title="Frequently asked questions." />
        <p class="mt-5 text-sm text-fg-secondary">
          Something else? <a href="/support" class="link-quiet">Get in touch</a>.
        </p>
      </div>
      <div class="lg:col-span-8" data-reveal>
        <Faq items={faq} />
      </div>
    </div>
  </section>

  <CtaSection />
</BaseLayout>
