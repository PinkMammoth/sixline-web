---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/ui/PageHeader.astro';
import Eyebrow from '~/components/ui/Eyebrow.astro';
import Arrangement from '~/components/music/Arrangement.astro';
import Closing from '~/components/home/Closing.astro';
import { availableFeatures, featureById, pillarMeta, trademarkNotice } from '~/data/features';

// Riff Blocks detail, from the owner's description of desktop app v0.6.0
const riffBlocks = [
  {
    title: 'Name what you’ve written',
    body: 'Select whole bars and create a Riff Block, such as “Main Riff”, “Chorus” or “Fill A”, for the active track or all tracks. The music stays where it is.',
  },
  {
    title: 'Place it anywhere in the song',
    body: 'Insert a block at the caret as new bars, or replace existing bars. Each track maps to a matching track, and nothing is retuned or re-fingered.',
  },
  {
    title: 'Linked or independent',
    body: 'Linked copies are labelled with the block’s name. Edit one and choose: update every linked copy, or change just this one and let it go its own way.',
  },
  {
    title: 'Edit deliberately',
    body: 'Open a block in its own editing session. Other copies only change when you commit, and the whole commit is a single undo step.',
  },
  {
    title: 'A library for every song',
    body: 'See each block’s size and placements, rename or duplicate it, make variations like “Main Riff B” and jump between occurrences.',
  },
  {
    title: 'Still just music',
    body: 'Blocks are ordinary bars in the score, so playback, printing and MIDI export work exactly as before. Saves and autosaves keep the whole library.',
  },
];

const others = availableFeatures('create').filter((f) => f.id !== 'riff-blocks');
const riff = featureById('riff-blocks');
---

<BaseLayout
  title="Create"
  description="Write in tab and notation, build multitrack arrangements and reuse your best ideas with Riff Blocks. Import Guitar Pro 3–5 and MIDI; export MIDI, print or PDF."
>
  <PageHeader eyebrow="Create" title="From first riff<br />to finished arrangement.">
    <p>{pillarMeta.create.intro}</p>
  </PageHeader>

  <!-- Riff Blocks -->
  <section class="paper grain section-y" aria-labelledby="riff-title">
    <div class="container-wide">
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <Eyebrow index="01">Riff Blocks</Eyebrow>
          <h2 id="riff-title" class="mt-7 text-h1 tracking-display text-fg">Write it once.<br /><span class="text-fg-secondary">Use it everywhere.</span></h2>
        </div>
        <p class="max-w-md text-lead text-fg-secondary lg:col-span-5 lg:pb-2">{riff?.description}</p>
      </div>

      <div class="mt-14 grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-10">
        <ol class="grid grid-cols-1 gap-x-8 gap-y-8 sm:grid-cols-2 lg:col-span-6">
          {
            riffBlocks.map((r, i) => (
              <li class="border-t border-line pt-5" data-reveal>
                <p class="font-mono text-sm text-accent-text">0{i + 1}</p>
                <h3 class="mt-2 text-h4 text-fg">{r.title}</h3>
                <p class="mt-2 text-sm text-fg-secondary">{r.body}</p>
              </li>
            ))
          }
        </ol>
        <figure class="lg:col-span-6" data-reveal>
          <div class="studio relative rounded-2xl bg-warm-2 p-4 shadow-frame sm:p-8">
            <Arrangement />
            <span class="label-mono absolute top-4 right-4 rounded-full border border-line bg-bg px-2.5 py-1 text-[0.625rem] text-accent-text sm:top-5 sm:right-5">
              Illustration
            </span>
          </div>
          <figcaption class="mt-4 text-sm text-fg-muted">
            Illustration only. A real capture of Riff Blocks in SixLine will replace it.
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Everything else -->
  <section class="grain section-y bg-warm-1" aria-labelledby="editor-title">
    <div class="container-content grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-5" data-reveal>
        <Eyebrow index="02">The editor</Eyebrow>
        <h2 id="editor-title" class="mt-7 text-h1 tracking-display text-fg">A serious editor, built for guitarists.</h2>
        <p class="mt-6 max-w-md text-lead text-fg-secondary">
          Everything you write is ready to practise too: select any bars and press Practise.
        </p>
        <a href="/practice" class="mt-8 inline-block text-sm font-medium text-fg"><span class="link-quiet">How practice works</span> <span aria-hidden="true">→</span></a>
      </div>
      <div class="lg:col-span-6 lg:col-start-7" data-reveal style="--reveal-delay:100ms">
        <ul class="border-t border-line">
          {
            others.map((f) => (
              <li class="border-b border-line py-7">
                <h3 class="text-h3 text-fg">{f.title}</h3>
                <p class="mt-2 text-fg-secondary">{f.description}</p>
              </li>
            ))
          }
        </ul>
        <p class="mt-6 text-[0.8125rem] text-fg-muted">{trademarkNotice}</p>
      </div>
    </div>
  </section>

  <Closing title="Start with a riff." primary={{ label: 'See how practice works', href: '/practice' }} />
</BaseLayout>
