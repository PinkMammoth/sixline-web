---
/**
 * Button / link-button.
 *
 * Variants: primary (amber, the one obvious action), secondary (outlined),
 * ghost (text). `arrow` adds a trailing arrow that nudges on hover.
 *
 * If `href` is null/undefined and `pending` is set, renders an honest
 * non-interactive "coming soon" state with the same footprint — used for
 * checkout and download actions before launch.
 */
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'a'>, 'href'> {
  href?: string | null;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'lg';
  pending?: string;
  arrow?: boolean;
  type?: 'button' | 'submit';
}

const { href, variant = 'primary', size = 'md', pending, arrow = false, class: className, type = 'button', ...rest } = Astro.props;

const isPending = !href && pending;

const base =
  'group relative inline-flex max-w-full items-center justify-center gap-x-2.5 gap-y-1 rounded-md font-medium select-none ' +
  'transition-[background-color,border-color,color,box-shadow,transform] duration-(--duration-base) ease-(--ease-quiet)';

const sizes = {
  md: 'min-h-11 py-2 px-5 text-sm',
  lg: 'min-h-13 py-2.5 px-7 text-base',
};

const variants = {
  primary:
    'bg-accent text-on-accent shadow-button hover:bg-accent-hover active:bg-accent-active active:translate-y-px active:shadow-none',
  secondary:
    'border border-line text-fg hover:border-line-strong hover:bg-[var(--sl-hover-overlay)] active:bg-[var(--sl-active-overlay)] active:translate-y-px',
  ghost: 'text-fg-secondary hover:text-fg active:translate-y-px',
};

const pendingStyles = {
  primary: 'border border-dashed border-accent/45 bg-accent-soft text-fg cursor-default',
  secondary: 'border border-dashed border-line text-fg-secondary cursor-default',
  ghost: 'text-fg-muted cursor-default',
};

const classes = [base, sizes[size], isPending ? [pendingStyles[variant], 'flex-wrap text-center'] : [variants[variant], 'whitespace-nowrap'], className];
---

{
  isPending ? (
    <span class:list={classes} data-state="pending">
      <span class="whitespace-nowrap">
        <slot />
      </span>
      <span class="label-mono whitespace-nowrap text-[0.6875rem] text-fg-muted">
        <span class="sr-only">(</span>
        {pending}
        <span class="sr-only">)</span>
      </span>
    </span>
  ) : href ? (
    <a href={href} class:list={classes} {...rest}>
      <slot />
      {arrow && (
        <svg class="transition-transform duration-(--duration-base) ease-(--ease-quiet) group-hover:translate-x-0.5" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
          <path d="M1 7h11M8 3l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      )}
    </a>
  ) : (
    <button type={type} class:list={classes} {...(rest as HTMLAttributes<'button'>)}>
      <slot />
    </button>
  )
}
