---
import StatusLabel from './StatusLabel.astro';
import { statusMeta, type FeatureStatus } from '~/data/features';

interface Props {
  class?: string;
}
const order: FeatureStatus[] = ['available', 'in-development', 'planned', 'unconfirmed'];
---

<div class:list={['rounded-lg border border-line-subtle bg-surface-1 p-5 sm:p-6', Astro.props.class]}>
  <p class="label-mono text-fg-muted">How to read feature status</p>
  <dl class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      order.map((s) => (
        <div>
          <dt>
            <StatusLabel status={s} />
          </dt>
          <dd class="mt-2 text-sm text-fg-secondary">{statusMeta[s].description}</dd>
        </div>
      ))
    }
  </dl>
</div>
