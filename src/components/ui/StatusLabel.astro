---
/**
 * Status label. Status is communicated by text AND shape, never colour alone:
 *   available       ● filled dot
 *   in-development  ◐ half-filled dot
 *   planned         ○ ring
 *   unconfirmed     ◌ dashed ring
 *   pre-launch      ◐ half-filled (used for overall product status)
 */
import { statusMeta, type FeatureStatus } from '~/data/features';

type Status = FeatureStatus | 'pre-launch';

interface Props {
  status: Status;
  /** Override the default label text. */
  label?: string;
  /** Allow long labels to wrap on narrow screens. */
  wrap?: boolean;
  class?: string;
}

const { status, label, wrap = false, class: className } = Astro.props;

const text = label ?? (status === 'pre-launch' ? 'In development' : statusMeta[status].label);

const tone: Record<Status, string> = {
  available: 'text-sage border-sage/35',
  'in-development': 'text-accent-text border-accent/35',
  'pre-launch': 'text-accent-text border-accent/35',
  planned: 'text-fg-secondary border-line-strong',
  unconfirmed: 'text-fg-muted border-line',
};
---

<span
  class:list={[
    'label-mono inline-flex max-w-full items-center gap-2 rounded-full border px-2.5 py-1',
    wrap ? 'rounded-xl' : 'whitespace-nowrap',
    tone[status],
    className,
  ]}
  data-status={status}
>
  <svg width="8" height="8" viewBox="0 0 8 8" aria-hidden="true" class="shrink-0">
    {status === 'available' && <circle cx="4" cy="4" r="4" fill="currentColor" />}
    {(status === 'in-development' || status === 'pre-launch') && (
      <>
        <circle cx="4" cy="4" r="3.25" fill="none" stroke="currentColor" stroke-width="1.5" />
        <path d="M4 0.75 A3.25 3.25 0 0 1 4 7.25 Z" fill="currentColor" />
      </>
    )}
    {status === 'planned' && <circle cx="4" cy="4" r="3.25" fill="none" stroke="currentColor" stroke-width="1.5" />}
    {status === 'unconfirmed' && (
      <circle cx="4" cy="4" r="3.25" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="1.6 1.4" />
    )}
  </svg>
  {text}
</span>
