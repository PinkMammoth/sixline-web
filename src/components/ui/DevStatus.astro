---
/**
 * Development status panel. Fully content-driven from
 * src/data/site.ts, src/data/development.ts and the releases collection.
 * Empty data renders explicit "published at beta launch" states.
 */
import StatusLabel from './StatusLabel.astro';
import { site } from '~/data/site';
import { development } from '~/data/development';
import { getReleases, formatDate } from '~/data/releases';

interface Props {
  headingLevel?: 'h3' | 'h2';
  showReleaseLink?: boolean;
}

const { headingLevel: H = 'h3', showReleaseLink = true } = Astro.props;
const [latest] = await getReleases();
const pending = 'Published with the public beta.';
---

<div class="grid gap-px overflow-hidden rounded-xl border border-line-subtle bg-line-subtle md:grid-cols-2">
  <section class="bg-bg p-6 sm:p-8" aria-labelledby="dev-version">
    <H id="dev-version" class="label-mono font-mono text-fg-muted">Current version</H>
    <p class="mt-4 font-display text-h3 text-fg">{site.appVersion ?? 'Pre-release'}</p>
    <StatusLabel status="pre-launch" label={site.appVersion ? 'Beta' : 'In development'} class="mt-4" />
  </section>

  <section class="bg-bg p-6 sm:p-8" aria-labelledby="dev-recent">
    <H id="dev-recent" class="label-mono font-mono text-fg-muted">Recent changes</H>
    {
      latest ? (
        <div class="mt-4">
          <p class="font-display text-h4 text-fg">
            {latest.data.version}
            <span class="ml-2 text-sm font-normal text-fg-muted">
              <time datetime={latest.data.date.toISOString()}>{formatDate(latest.data.date)}</time>
            </span>
          </p>
          <p class="mt-2 text-sm text-fg-secondary">{latest.data.summary}</p>
        </div>
      ) : (
        <p class="mt-4 text-sm text-fg-secondary">No public releases yet. Release notes will appear here from the first beta build.</p>
      )
    }
  </section>

  <section class="bg-bg p-6 sm:p-8" aria-labelledby="dev-next">
    <H id="dev-next" class="label-mono font-mono text-fg-muted">Upcoming priorities</H>
    {
      development.upcomingPriorities.length ? (
        <ul class="mt-4 space-y-2 text-sm text-fg-secondary">
          {development.upcomingPriorities.map((p) => <li class="flex gap-3"><span class="text-fg-muted" aria-hidden="true">—</span>{p}</li>)}
        </ul>
      ) : (
        <p class="mt-4 text-sm text-fg-secondary">{pending}</p>
      )
    }
  </section>

  <section class="bg-bg p-6 sm:p-8" aria-labelledby="dev-limits">
    <H id="dev-limits" class="label-mono font-mono text-fg-muted">Beta limitations</H>
    {
      development.betaLimitations.length ? (
        <ul class="mt-4 space-y-2 text-sm text-fg-secondary">
          {development.betaLimitations.map((p) => <li class="flex gap-3"><span class="text-fg-muted" aria-hidden="true">—</span>{p}</li>)}
        </ul>
      ) : (
        <p class="mt-4 text-sm text-fg-secondary">{pending}</p>
      )
    }
  </section>
</div>
{
  showReleaseLink && (
    <p class="mt-6 text-sm">
      <a href="/updates" class="link-quiet text-fg-secondary">
        Release notes and development updates <span aria-hidden="true">→</span>
      </a>
    </p>
  )
}
