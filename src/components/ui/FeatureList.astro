---
/**
 * Feature list for one group. Each item shows its verified status, so
 * unconfirmed capabilities are never presented as released.
 */
import StatusLabel from './StatusLabel.astro';
import type { Feature } from '~/data/features';

interface Props {
  features: Feature[];
  /** 'list' = editorial rows (homepage), 'grid' = cards (features page). */
  layout?: 'list' | 'grid';
  headingLevel?: 'h3' | 'h4';
}

const { features, layout = 'list', headingLevel: H = 'h3' } = Astro.props;

// Empty cells that complete the last grid row at 2 (sm) and 3 (lg) columns,
// so the hairline grid never shows a gap.
const smFill = (2 - (features.length % 2)) % 2;
const lgFill = (3 - (features.length % 3)) % 3;
const fillers = Array.from({ length: Math.max(smFill, lgFill) }, (_, i) => ({ sm: i < smFill, lg: i < lgFill }));
---

{
  layout === 'list' ? (
    <ul class="divide-y divide-line-subtle border-y border-line-subtle">
      {features.map((f) => (
        <li class="grid gap-2 py-5 sm:grid-cols-[1fr_auto] sm:items-start sm:gap-6">
          <div>
            <H class="font-display text-h4 font-medium text-fg">{f.title}</H>
            <p class="mt-1 text-sm text-fg-secondary">{f.description}</p>
          </div>
          <StatusLabel status={f.status} class="justify-self-start sm:mt-0.5" />
        </li>
      ))}
    </ul>
  ) : (
    <ul class="grid gap-px overflow-hidden rounded-lg border border-line-subtle bg-line-subtle sm:grid-cols-2 lg:grid-cols-3">
      {features.map((f) => (
        <li class="flex flex-col gap-4 bg-bg p-6">
          <StatusLabel status={f.status} class="self-start" />
          <div>
            <H class="font-display text-h4 font-medium text-fg">{f.title}</H>
            <p class="mt-2 text-sm text-fg-secondary">{f.description}</p>
          </div>
        </li>
      ))}
      {fillers.map((f) => (
        <li class:list={['hidden bg-bg', f.sm ? 'sm:block' : 'sm:hidden', f.lg ? 'lg:block' : 'lg:hidden']} aria-hidden="true" />
      ))}
    </ul>
  )
}
