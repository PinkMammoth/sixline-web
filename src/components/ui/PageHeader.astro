---
/** Header for inner pages: eyebrow, large headline, lead, and the six-string motif. */
import Eyebrow from './Eyebrow.astro';

interface Props {
  eyebrow: string;
  title: string;
  /** Use the ivory paper treatment instead of the dark studio one. */
  paper?: boolean;
}
const { eyebrow, title, paper = false } = Astro.props;
---

<section class:list={['grain relative overflow-hidden border-b border-line-subtle', paper && 'paper']}>
  <div
    class="pointer-events-none absolute -top-48 right-[-8%] h-[36rem] w-[36rem] rounded-full bg-[radial-gradient(closest-side,var(--sl-glow-amber),transparent)]"
    aria-hidden="true"
  >
  </div>
  <div class="pointer-events-none absolute right-0 bottom-10 hidden w-[34%] flex-col gap-[11px] opacity-[0.14] lg:flex" aria-hidden="true">
    {[0, 1, 2, 3, 4, 5].map(() => <span class="block h-[1.5px] bg-fg" />)}
  </div>
  <div class="container-wide relative pt-16 pb-16 sm:pt-24 sm:pb-20">
    <Eyebrow>{eyebrow}</Eyebrow>
    <h1 class="mt-7 max-w-[18ch] text-h1 tracking-display text-fg" set:html={title} />
    {
      Astro.slots.has('default') && (
        <div class="mt-7 max-w-2xl text-lead text-fg-secondary">
          <slot />
        </div>
      )
    }
  </div>
</section>
