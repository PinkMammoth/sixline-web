---
/**
 * FAQ built on native <details>/<summary>: keyboard and screen-reader
 * accessible with no JavaScript.
 */
import type { FaqItem } from '~/data/faq';

interface Props {
  items: FaqItem[];
  class?: string;
}
const { items, class: className } = Astro.props;
---

<div class:list={['border-t border-line', className]}>
  {
    items.map((item) => (
      <details class="group border-b border-line" id={`faq-${item.id}`}>
        <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 text-left font-display text-[1.3125rem] leading-snug font-medium text-fg transition-colors duration-(--duration-base) hover:text-accent-text [&::-webkit-details-marker]:hidden">
          <span>{item.question}</span>
          <span class="grid size-8 shrink-0 place-items-center rounded-full border border-line text-fg-muted transition-[transform,border-color,color] duration-(--duration-base) ease-(--ease-quiet) group-open:rotate-45 group-open:border-accent group-open:text-accent-text group-hover:border-line-strong" aria-hidden="true">
            <svg width="12" height="12" viewBox="0 0 12 12">
              <path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
          </span>
        </summary>
        <div class="max-w-prose space-y-3 pb-7 text-fg-secondary">
          {item.answer.map((p) => <p>{p}</p>)}
        </div>
      </details>
    ))
  }
</div>
