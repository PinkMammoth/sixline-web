---
/**
 * FAQ built on native <details>/<summary>: keyboard and screen-reader
 * accessible with no JavaScript.
 */
import type { FaqItem } from '~/data/faq';

interface Props {
  items: FaqItem[];
  class?: string;
}
const { items, class: className } = Astro.props;
---

<div class:list={['border-t border-line-subtle', className]}>
  {
    items.map((item) => (
      <details class="faq group border-b border-line-subtle" id={`faq-${item.id}`}>
        <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-left font-display text-h4 font-medium text-fg transition-colors duration-(--duration-base) hover:text-accent-text [&::-webkit-details-marker]:hidden">
          <span>{item.question}</span>
          <svg
            class="shrink-0 text-fg-muted transition-transform duration-(--duration-base) ease-(--ease-quiet) group-open:rotate-45"
            width="14"
            height="14"
            viewBox="0 0 14 14"
            aria-hidden="true"
          >
            <path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
        </summary>
        <div class="max-w-prose space-y-3 pb-6 text-fg-secondary">
          {item.answer.map((p) => <p>{p}</p>)}
        </div>
      </details>
    ))
  }
</div>
