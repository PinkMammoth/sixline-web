---
/**
 * Product demo video. Never autoplays: native controls, preload="none",
 * playback only on explicit user action. Used once a real clip is set in
 * src/data/site.ts → media.
 */
interface Props {
  src: string;
  poster?: string;
  /** Accessible description of what the video shows. */
  label: string;
  captions?: string;
  aspect?: string;
  class?: string;
}

const { src, poster, label, captions, aspect = '16 / 10', class: className } = Astro.props;
---

<div class:list={['overflow-hidden rounded-2xl border border-line bg-surface-2 p-1.5 shadow-frame sm:p-2', className]}>
  <video
    class="block w-full rounded-xl bg-bg-sunken object-cover"
    style={`aspect-ratio:${aspect}`}
    controls
    preload="none"
    playsinline
    poster={poster}
    aria-label={label}
  >
    <source src={src} type="video/mp4" />
    {captions && <track kind="captions" src={captions} srclang="en" label="English" default />}
  </video>
</div>
