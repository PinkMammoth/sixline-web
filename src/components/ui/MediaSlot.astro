---
/**
 * Slot for a short real-product demo video.
 * Video never autoplays: it shows native controls and only loads metadata
 * after an explicit user action (preload="none").
 * Until a video is supplied, renders a labelled placeholder in the same frame.
 */
interface Props {
  /** e.g. '/demos/writing.mp4' (place files in public/demos/) */
  src?: string;
  /** Poster image shown before playback. */
  poster?: string;
  /** Accessible description of what the video shows. */
  label: string;
  /** Optional WebVTT captions file. */
  captions?: string;
  aspect?: string;
  class?: string;
}

const { src, poster, label, captions, aspect = '16 / 10', class: className } = Astro.props;
---

<div
  class:list={['overflow-hidden rounded-xl border border-line bg-surface-2 p-1.5 sm:p-2', className]}
>
  <div class="relative overflow-hidden rounded-lg bg-bg-sunken" style={`aspect-ratio:${aspect}`}>
    {
      src ? (
        <video
          class="absolute inset-0 size-full object-cover"
          controls
          preload="none"
          playsinline
          poster={poster}
          aria-label={label}
        >
          <source src={src} type="video/mp4" />
          {captions && <track kind="captions" src={captions} srclang="en" label="English" default />}
        </video>
      ) : (
        <div class="absolute inset-0 flex flex-col items-center justify-center gap-4 p-6 text-center">
          <span class="grid size-12 place-items-center rounded-full border border-line text-fg-muted" aria-hidden="true">
            <svg width="14" height="16" viewBox="0 0 14 16">
              <path d="M1 1.5v13l12-6.5z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
            </svg>
          </span>
          <div>
            <p class="label-mono text-fg-muted">Placeholder</p>
            <p class="mt-1.5 max-w-xs text-sm text-fg-secondary">{label} — product demo coming soon</p>
          </div>
        </div>
      )
    }
  </div>
</div>
