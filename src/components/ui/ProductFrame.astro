---
/**
 * Product showcase frame — presented like a photographed object: warm
 * graphite shell with a fine top highlight, quiet window chrome and a soft
 * pool of light beneath.
 *
 * Pass `src` + `alt` for a real screenshot (put it in src/assets/screenshots/
 * so Astro optimises it). Until then, the default slot renders placeholder
 * content and a visible label states that it is not the app.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src?: ImageMetadata | string;
  alt?: string;
  title?: string;
  aspect?: string;
  mobileAspect?: string;
  priority?: boolean;
  /** Label shown on the placeholder, e.g. "Illustration". */
  placeholderLabel?: string;
  placeholderNote?: string;
  class?: string;
}

const {
  src,
  alt = '',
  title = 'SixLine',
  aspect = '16 / 10',
  mobileAspect = '4 / 3',
  priority = false,
  placeholderLabel = 'Illustration',
  placeholderNote = 'App screenshot coming with the redesigned interface',
  class: className,
} = Astro.props;
---

<figure class:list={['product-frame relative', className]}>
  <div class="pointer-events-none absolute inset-x-[6%] -bottom-10 h-24 rounded-[50%] bg-[radial-gradient(closest-side,var(--sl-glow-amber),transparent)] blur-2xl" aria-hidden="true"></div>
  <div class="relative rounded-2xl border border-line bg-linear-to-b from-surface-3 to-surface-2 p-1.5 shadow-frame sm:p-2">
    <div class="flex h-7 items-center gap-3 px-2.5 sm:h-9" aria-hidden="true">
      <span class="flex gap-1.5">
        <span class="size-2.5 rounded-full bg-[var(--sl-border-strong)] opacity-60"></span>
        <span class="size-2.5 rounded-full bg-[var(--sl-border-strong)] opacity-60"></span>
        <span class="size-2.5 rounded-full bg-[var(--sl-border-strong)] opacity-60"></span>
      </span>
      <span class="flex-1 truncate text-center font-mono text-[0.6875rem] text-fg-muted">{title}</span>
      <span class="w-[42px]"></span>
    </div>

    <div
      class="relative aspect-(--frame-aspect-m) overflow-hidden rounded-xl bg-canvas sm:aspect-(--frame-aspect)"
      style={`--frame-aspect:${aspect};--frame-aspect-m:${mobileAspect}`}
    >
      {
        src ? (
          typeof src === 'string' ? (
            <img
              src={src}
              alt={alt}
              class="absolute inset-0 size-full object-cover object-left-top"
              loading={priority ? 'eager' : 'lazy'}
              fetchpriority={priority ? 'high' : 'auto'}
              decoding="async"
            />
          ) : (
            <Image
              src={src}
              alt={alt}
              widths={[640, 960, 1280, 1920, 2560]}
              sizes="(min-width: 86rem) 82rem, 100vw"
              class="absolute inset-0 size-full object-cover object-left-top"
              loading={priority ? 'eager' : 'lazy'}
              fetchpriority={priority ? 'high' : 'auto'}
            />
          )
        ) : (
          <>
            <slot />
            <p class="absolute top-3 right-3 z-10 flex items-center gap-2 rounded-full border border-line bg-bg/85 px-3 py-1.5 backdrop-blur-sm">
              <span class="label-mono text-[0.625rem] text-accent-text">{placeholderLabel}</span>
              <span class="hidden text-[0.75rem] text-fg-secondary sm:inline">{placeholderNote}</span>
            </p>
          </>
        )
      }
    </div>
  </div>
  {
    Astro.slots.has('caption') && (
      <figcaption class="mt-5 text-sm text-fg-muted">
        <slot name="caption" />
      </figcaption>
    )
  }
</figure>
