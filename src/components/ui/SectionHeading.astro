---
interface Props {
  eyebrow?: string;
  title: string;
  /** Heading level. Pages use h1 once; homepage sections use h2. */
  as?: 'h1' | 'h2' | 'h3';
  align?: 'start' | 'center';
  id?: string;
  class?: string;
}

const { eyebrow, title, as: Tag = 'h2', align = 'start', id, class: className } = Astro.props;
const size = Tag === 'h1' ? 'text-h1' : Tag === 'h2' ? 'text-h2' : 'text-h3';
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center', className]}>
  {eyebrow && <p class="label-mono mb-4 text-fg-muted">{eyebrow}</p>}
  <Tag id={id} class:list={[size, 'text-fg']}>{title}</Tag>
  {
    Astro.slots.has('default') && (
      <div class="mt-5 text-lead text-fg-secondary">
        <slot />
      </div>
    )
  }
</div>
