---
import Button from '~/components/ui/Button.astro';
import TabStaff from '~/components/ui/TabStaff.astro';
import { actions, trialHref } from '~/data/site';

interface Props {
  title?: string;
}
const { title = 'Write your next song in SixLine.' } = Astro.props;
---

<section class="section-y border-t border-line-subtle" aria-labelledby="cta-title">
  <div class="container-content">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <TabStaff class="mx-auto mb-10 max-w-sm" />
      <h2 id="cta-title" class="text-h2 text-fg">{title}</h2>
      <p class="mt-5 text-lead text-fg-secondary">No subscriptions. No paid upgrades. Just music.</p>
      <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
        <Button href={trialHref} pending="Coming soon" size="lg">Try SixLine free</Button>
        <Button href={actions.checkoutUrl} variant="secondary" pending="Coming soon" size="lg">Get lifetime access</Button>
      </div>
    </div>
  </div>
</section>
