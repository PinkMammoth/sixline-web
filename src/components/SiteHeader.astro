---
import Logo from './brand/Logo.astro';
import Button from './ui/Button.astro';
import { primaryNav } from '~/data/navigation';
import { trialHref } from '~/data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="sticky top-0 z-40 border-b border-line-subtle bg-bg/85 backdrop-blur-md">
  <div class="container-wide flex h-[4.5rem] items-center justify-between gap-6">
    <a href="/" class="-m-2 rounded-sm p-2 text-fg" aria-label="SixLine home">
      <Logo variant="horizontal" height={30} label="" />
    </a>

    <div class="hidden items-center gap-6 md:flex">
      <nav aria-label="Primary">
        <ul class="flex items-center gap-1">
          {
            primaryNav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    'relative rounded-md px-3 py-2 text-sm transition-colors duration-(--duration-base)',
                    isCurrent(item.href) ? 'text-fg' : 'text-fg-secondary hover:text-fg',
                  ]}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                >
                  {item.label}
                  {isCurrent(item.href) && <span class="absolute -bottom-0.5 left-1/2 size-1 -translate-x-1/2 rounded-full bg-accent" aria-hidden="true" />}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      {trialHref && <Button href={trialHref} class="min-h-10 px-4">Try free</Button>}
    </div>

    <button
      type="button"
      class="-mr-2 inline-flex h-10 items-center gap-2 rounded-md px-3 text-sm text-fg-secondary hover:text-fg md:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav"
      data-nav-toggle
      hidden
    >
      <span data-nav-toggle-label>Menu</span>
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" class="nav-icon">
        <path class="nav-icon__a" d="M2 5h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        <path class="nav-icon__b" d="M2 11h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <!-- Mobile navigation. Visible without JS; collapsed behind the Menu button when JS runs. -->
  <nav id="mobile-nav" aria-label="Primary" class="mobile-nav border-t border-line-subtle md:hidden" data-nav-panel>
    <ul class="container-wide flex flex-col pt-2 pb-6">
      {
        primaryNav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'flex items-center justify-between border-b border-line-subtle py-4 font-display text-h3',
                isCurrent(item.href) ? 'text-fg' : 'text-fg-secondary',
              ]}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
              {isCurrent(item.href) && <span class="size-1.5 rounded-full bg-accent" aria-hidden="true" />}
            </a>
          </li>
        ))
      }
      <li class="pt-6">
        <Button href={trialHref ?? '/features'} size="lg" class="w-full" arrow>{trialHref ? 'Try SixLine free' : 'Explore SixLine'}</Button>
      </li>
    </ul>
  </nav>
</header>

<style>
  :global(.js) .mobile-nav:not(.is-open) {
    display: none;
  }
  .nav-icon path {
    transform-box: view-box;
    transform-origin: 8px 8px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .nav-icon path {
      transition: transform var(--duration-base) var(--ease-quiet);
    }
  }
  [aria-expanded='true'] .nav-icon__a {
    transform: translateY(3px) rotate(45deg);
  }
  [aria-expanded='true'] .nav-icon__b {
    transform: translateY(-3px) rotate(-45deg);
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-nav-panel]');
  if (toggle && panel) {
    toggle.hidden = false;
    const label = toggle.querySelector('[data-nav-toggle-label]');
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      panel.classList.toggle('is-open', open);
      if (label) label.textContent = open ? 'Close' : 'Menu';
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    window.matchMedia('(min-width: 48rem)').addEventListener('change', (e) => e.matches && setOpen(false));
  }
</script>
