---
import Logo from './brand/Logo.astro';
import { footerColumns } from '~/data/navigation';
import { site } from '~/data/site';
import { trademarkNotice } from '~/data/features';

const year = new Date().getFullYear();
---

<footer class="grain border-t border-line-subtle bg-bg-sunken">
  <div class="container-wide grid grid-cols-1 gap-14 py-16 lg:grid-cols-[1fr_2fr] lg:py-24">
    <div>
      <a href="/" class="inline-block rounded-sm text-fg" aria-label="SixLine home">
        <Logo variant="stacked" height={112} label="" />
      </a>
      <p class="mt-8 max-w-xs font-display text-h4 text-fg">{site.tagline}</p>
      <p class="label-mono mt-4 text-fg-muted">{site.platformLabel}</p>
    </div>

    <div class="grid grid-cols-2 gap-10 sm:grid-cols-3 lg:pt-2">
      {
        footerColumns.map((col) => (
          <div>
            <h2 class="label-mono text-fg-muted">{col.title}</h2>
            <ul class="mt-5 space-y-3.5 text-sm">
              {col.links.map((link) => (
                <li>
                  {link.href ? (
                    <a href={link.href} class="text-fg-secondary transition-colors hover:text-fg">
                      {link.label}
                    </a>
                  ) : (
                    <span class="text-fg-muted">
                      {link.label}
                      <span class="label-mono ml-1.5 text-[0.625rem] text-fg-disabled">Soon</span>
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>

  <div class="border-t border-line-subtle">
    <div class="container-wide flex flex-col gap-3 py-7 text-[0.8125rem] text-fg-muted lg:flex-row lg:justify-between lg:gap-10">
      <p>© {year} SixLine. All rights reserved.</p>
      <p class="max-w-3xl lg:text-right">
        {trademarkNotice} Windows is a trademark of Microsoft Corporation. macOS is a trademark of Apple Inc.
      </p>
    </div>
  </div>
</footer>
