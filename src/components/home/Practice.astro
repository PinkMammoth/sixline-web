---
/**
 * Pillar 1 — Practice (the primary showcase). Every stage leads with
 * `available` features; launch previews appear only as small, labelled
 * add-ons. Nothing here implies SixLine assesses playing automatically:
 * Clean / Retry is always the musician's own call.
 */
import Eyebrow from '~/components/ui/Eyebrow.astro';
import TabStaff from '~/components/music/TabStaff.astro';
import { pillarMeta, practiceStage, stageMeta, type PracticeStage } from '~/data/features';
import { riff, riffAnswer } from '~/data/riffs';

const bars = [...riff, ...riffAnswer];

const stages: { id: PracticeStage; story: string }[] = [
  {
    id: 'focus',
    story:
      'Bars 33–36 of the solo keep tripping you up. Select them and press Practise: the score focuses on just those bars, with loop, speed, metronome and count-in ready. Save them as a target and they’re waiting next time.',
  },
  {
    id: 'progress',
    story:
      'Start slowly. After each run, mark it Clean or Retry; you’re the judge. Three clean passes and the Tempo Ladder steps the tempo up. Every attempt is saved with the project.',
  },
  {
    id: 'plan',
    story:
      'Keep a saved target for each hard part of the song (the opening riff, the bridge, the solo’s last run), each with its own settings and history. Then work through whatever needs it most.',
  },
];

// Illustrative Tempo Ladder: three clean passes per rung (values are examples)
const ladder = [
  { tempo: '70%', clean: 3 },
  { tempo: '75%', clean: 3 },
  { tempo: '80%', clean: 1 },
];
---

<section id="practice" class="paper grain section-y overflow-hidden" aria-labelledby="practice-title">
  <div class="container-wide">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12" data-reveal>
      <div class="lg:col-span-12">
        <Eyebrow index="01">{pillarMeta.practice.label}</Eyebrow>
        <h2 id="practice-title" class="mt-7 text-display font-medium tracking-display text-fg">
          From “I can’t play this”<br /><span class="text-fg-secondary">to “I’ve got it.”</span>
        </h2>
      </div>
      <p class="max-w-xl text-lead text-fg-secondary lg:col-span-5 lg:col-start-8">{pillarMeta.practice.intro}</p>
    </div>

    <!-- Practice console: a looped passage and an illustrated Tempo Ladder -->
    <figure class="mt-14 lg:mt-16" data-reveal data-playback style="--reveal-delay:100ms">
      <div class="studio rounded-2xl border border-line bg-linear-to-b from-warm-2 to-warm-1 p-2 shadow-frame">
        <div class="rounded-xl bg-canvas px-3 pt-6 pb-4 sm:px-8 sm:pt-10">
          <div class="hidden md:block"><TabStaff bars={bars} barWidth={360} playhead loop={[1, 3]} passes={2} duration={4.2} /></div>
          <div class="hidden sm:block md:hidden"><TabStaff bars={riff} barWidth={360} playhead loop={[1, 2]} passes={2} duration={2.6} /></div>
          <div class="sm:hidden"><TabStaff bars={[riff[1]]} barWidth={380} playhead loop={[0, 1]} passes={2} duration={2.4} clef={false} /></div>
        </div>
        <div class="grid grid-cols-1 items-center gap-4 px-3 py-4 sm:px-5 md:grid-cols-[auto_1fr_auto] md:gap-6">
          <button
            type="button"
            class="inline-flex h-10 items-center gap-2.5 justify-self-start rounded-full bg-accent pr-4 pl-3 text-sm font-medium text-on-accent shadow-button transition-[background-color,transform] duration-(--duration-base) hover:bg-accent-hover active:translate-y-px"
            data-playback-trigger
            hidden
          >
            <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
              <path d="M11.5 5A5 5 0 1 0 12 8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
              <path d="M12.5 1.5V5H9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span data-playback-label>Loop the passage</span>
          </button>

          <!-- Illustrated Tempo Ladder: rungs advance after three clean passes -->
          <ol class="flex flex-wrap items-center gap-x-3 gap-y-2" aria-label="Tempo Ladder illustration">
            {
              ladder.map((r, i) => (
                <li class="flex items-center gap-3">
                  {i > 0 && <span class="text-fg-muted" aria-hidden="true">→</span>}
                  <span class:list={['flex items-center gap-2 rounded-full border px-3 py-1.5 font-mono text-[0.6875rem]', i === ladder.length - 1 ? 'border-accent/50 text-fg' : 'border-line text-fg-secondary']}>
                    <span class="text-sage">♩</span>
                    {r.tempo}
                    <span class="flex gap-1" aria-hidden="true">
                      {[0, 1, 2].map((d) => (
                        <span class:list={['size-1.5 rounded-full', d < r.clean ? 'bg-sage' : 'border border-line-strong']} />
                      ))}
                    </span>
                    <span class="sr-only">{r.clean} of 3 clean passes</span>
                  </span>
                </li>
              ))
            }
          </ol>
          <p class="label-mono text-fg-muted md:text-right">Illustration · no audio</p>
        </div>
      </div>
      <figcaption class="mt-4 text-sm text-fg-muted">
        Illustration drawn by this website: a looped passage climbing the Tempo Ladder, three clean passes per step. A real
        capture of Practice Mode will replace it.
      </figcaption>
    </figure>

    <!-- The central idea -->
    <div class="mt-20 grid grid-cols-1 gap-10 border-t border-line pt-12 lg:mt-24 lg:grid-cols-12 lg:gap-10" data-reveal>
      <p class="font-display text-h1 tracking-display text-fg lg:col-span-6">
        A loop repeats.<br /><span class="text-accent-text">A plan progresses.</span>
      </p>
      <dl class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:col-span-6 lg:pt-3">
        <div>
          <dt class="label-mono text-fg-muted">A loop</dt>
          <dd class="mt-3 text-fg-secondary">Plays the same bars at the same speed until you stop it. Useful, but it can’t tell you whether you’re improving.</dd>
        </div>
        <div>
          <dt class="label-mono text-accent-text">A plan</dt>
          <dd class="mt-3 text-fg">
            Knows the passage you’re working on, the tempo you’ve earned through clean runs and your history, so tomorrow starts where today finished.
          </dd>
        </div>
      </dl>
    </div>

    <!-- The three stages, each led by what's available now -->
    <ol class="mt-16 grid grid-cols-1 gap-x-8 gap-y-14 lg:mt-20 lg:grid-cols-3" data-reveal>
      {
        stages.map((s, i) => {
          const now = practiceStage(s.id, 'available');
          const soon = practiceStage(s.id, 'preview').filter((f) => f.id === 'practice-queue' || f.id === 'in-play-bookmark');
          return (
            <li class="flex flex-col border-t border-line pt-6">
              <p class="label-mono text-fg-muted">
                <span class="text-accent-text">0{i + 1}</span> · {stageMeta[s.id].label}
              </p>
              <h3 class="mt-4 text-h2 tracking-display text-fg">{stageMeta[s.id].title}</h3>
              <p class="mt-4 text-fg-secondary">{s.story}</p>
              {now.length > 0 && (
                <ul class="mt-6 space-y-2.5">
                  {now.map((f) => (
                    <li class="flex gap-3 text-sm text-fg">
                      <svg class="mt-1.5 shrink-0 text-sage" width="13" height="10" viewBox="0 0 15 11" aria-hidden="true">
                        <path d="M1 5.5l4.2 4L14 1" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                      {f.title}
                    </li>
                  ))}
                </ul>
              )}
              {soon.length > 0 && (
                <ul class="mt-5 space-y-2 border-t border-dashed border-line pt-4">
                  {soon.map((f) => (
                    <li class="text-sm text-fg-secondary">
                      <span class="label-mono mr-2 text-[0.625rem] text-accent-text">Launch preview</span>
                      {f.title}
                    </li>
                  ))}
                </ul>
              )}
            </li>
          );
        })
      }
    </ol>

    <div class="mt-14 flex flex-col gap-6 rounded-xl bg-bg-sunken px-6 py-5 sm:flex-row sm:items-center sm:justify-between" data-reveal>
      <p class="text-sm text-fg-secondary">
        <strong class="font-medium text-fg">Honest feedback, by design.</strong> SixLine doesn’t listen to or grade your playing.
        You decide what counts as clean.
      </p>
      <a href="/practice" class="shrink-0 text-sm font-medium text-fg"><span class="link-quiet">Everything in Practice</span> <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<script>
  // Sweeps the loop region twice when first scrolled into view; the button replays it.
  // Reduced motion: no animation (the playhead rests in the loop) and no button.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  for (const fig of document.querySelectorAll<HTMLElement>('[data-playback]')) {
    const btn = fig.querySelector<HTMLButtonElement>('[data-playback-trigger]');
    const label = fig.querySelector('[data-playback-label]');
    if (reduce || !btn) continue;
    btn.hidden = false;
    const play = () => {
      fig.classList.remove('is-playing');
      void fig.offsetWidth; // restart CSS animations
      fig.classList.add('is-playing');
      if (label) label.textContent = 'Loop it again';
    };
    btn.addEventListener('click', play);
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          setTimeout(play, 700);
        }
      },
      { threshold: 0.6 },
    );
    io.observe(fig);
  }
</script>
