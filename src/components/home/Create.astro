---
/**
 * Promise 1 — Create. Outcome-led: each item is something a musician gets
 * done, backed by a feature that is `available` in src/data/features.ts.
 * Items whose feature isn't available are not rendered.
 */
import Eyebrow from '~/components/ui/Eyebrow.astro';
import MediaSlot from '~/components/ui/MediaSlot.astro';
import Arrangement from '~/components/music/Arrangement.astro';
import { features, groupMeta, trademarkNotice } from '~/data/features';
import { media } from '~/data/site';

const isAvailable = (...ids: string[]) => ids.every((id) => features.find((f) => f.id === id)?.status === 'available');

const outcomes = [
  {
    ids: ['riff-blocks'],
    title: 'Catch the idea',
    body: 'Capture riffs as Riff Blocks the moment they arrive, then build your songs from them.',
  },
  {
    ids: ['tab-notation'],
    title: 'Write every part',
    body: 'Guitar and bass parts in tablature, with standard notation alongside.',
  },
  {
    ids: ['multi-track'],
    title: 'Build the song',
    body: 'Stack parts into multitrack arrangements and hear how ideas work together.',
  },
  {
    ids: ['gp-import', 'midi'],
    title: 'Bring your tabs',
    body: 'Open your Guitar Pro files and work with MIDI, then carry on writing.',
  },
].filter((o) => isAvailable(...o.ids));
---

<section id="create" class="paper grain section-y overflow-hidden" aria-labelledby="create-title">
  <div class="container-wide">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12" data-reveal>
      <div class="lg:col-span-12">
        <Eyebrow index="01">{groupMeta.writing.label}</Eyebrow>
        <h2 id="create-title" class="mt-7 text-display font-medium tracking-display text-fg">
          From first riff<br />
          <span class="text-fg-secondary">to finished arrangement.</span>
        </h2>
      </div>
      <p class="max-w-xl text-lead text-fg-secondary lg:col-span-5 lg:col-start-8">{groupMeta.writing.intro}</p>
    </div>

    <div class="mt-16 grid grid-cols-1 gap-14 lg:mt-20 lg:grid-cols-12 lg:gap-10">
      <ol class="grid grid-cols-1 gap-x-8 gap-y-9 sm:grid-cols-2 lg:col-span-4 lg:grid-cols-1 lg:gap-y-8" data-reveal>
        {
          outcomes.map((o, i) => (
            <li class="grid grid-cols-[2.25rem_1fr] gap-x-3 border-t border-line pt-5">
              <span class="font-mono text-sm text-accent-text">0{i + 1}</span>
              <div>
                <h3 class="text-h3 text-fg">{o.title}</h3>
                <p class="mt-2 text-fg-secondary">{o.body}</p>
              </div>
            </li>
          ))
        }
        <li class="text-[0.8125rem] text-fg-muted sm:col-span-2 lg:col-span-1">{trademarkNotice}</li>
      </ol>

      {
        media.writingDemo ? (
          <div class="lg:col-span-7 lg:col-start-6" data-reveal>
            <MediaSlot {...media.writingDemo} label="Riff Blocks in SixLine: a riff captured and built into a multitrack arrangement" />
          </div>
        ) : (
          <figure class="lg:col-span-7 lg:col-start-6" data-reveal style="--reveal-delay:120ms">
            <div class="relative rounded-2xl bg-warm-1 p-4 sm:p-8 lg:p-10">
              <Arrangement />
              <span class="label-mono absolute top-4 right-4 rounded-full border border-line bg-bg px-2.5 py-1 text-[0.625rem] text-accent-text sm:top-5 sm:right-5">
                Illustration
              </span>
            </div>
            <figcaption class="mt-4 text-sm text-fg-muted">
              Illustration of a riff growing into an arrangement. Real footage of Riff Blocks in SixLine will take its place.
            </figcaption>
          </figure>
        )
      }
    </div>
  </div>
</section>
