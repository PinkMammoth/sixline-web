---
/**
 * Pillar 2 — Create. Three propositions (linked ideas, safe experimentation,
 * creative possibilities); each lists its features with their real status
 * from src/data/features.ts. Established editor features sit in a compact
 * supporting list.
 */
import Eyebrow from '~/components/ui/Eyebrow.astro';
import MediaSlot from '~/components/ui/MediaSlot.astro';
import Arrangement from '~/components/music/Arrangement.astro';
import FeatureLine from '~/components/ui/FeatureLine.astro';
import { createTheme, pillarMeta, themeMeta, trademarkNotice } from '~/data/features';
import { media } from '~/data/site';

const propositions = [
  {
    theme: 'ideas' as const,
    body: 'Name a passage once, as “Main Riff”, “Chorus” or “Fill A”, and place it wherever the song needs it. Edit it once to update every linked copy.',
  },
  {
    theme: 'experiment' as const,
    body: 'Try an idea without putting the original at risk: branch a riff into a variation, or change one copy while the rest stay put.',
  },
  {
    theme: 'possibilities' as const,
    body: 'Ideas we’re exploring: other voicings, fingerings and harmonies for what you’ve written, to try, edit or ignore. Not part of the launch plan yet.',
  },
];
const editor = createTheme('editor');
---

<section id="create" class="grain section-y overflow-hidden bg-warm-1" aria-labelledby="create-title">
  <div class="container-wide">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12" data-reveal>
      <div class="lg:col-span-12">
        <Eyebrow index="02">{pillarMeta.create.label}</Eyebrow>
        <h2 id="create-title" class="mt-7 text-display font-medium tracking-display text-fg">
          From first riff<br />
          <span class="text-fg-secondary">to finished arrangement.</span>
        </h2>
      </div>
      <p class="max-w-xl text-lead text-fg-secondary lg:col-span-5 lg:col-start-8">{pillarMeta.create.intro}</p>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-14 lg:mt-16 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-5" data-reveal>
        <ol class="space-y-8">
          {
            propositions.map((p, i) => (
              <li class="grid grid-cols-[2.25rem_1fr] gap-x-3 border-t border-line pt-5">
                <span class="font-mono text-sm text-accent-text">0{i + 1}</span>
                <div>
                  <h3 class="text-h3 text-fg">{themeMeta[p.theme].title}</h3>
                  <p class="mt-2 text-fg-secondary">{p.body}</p>
                  <ul class="mt-4 space-y-2">
                    {createTheme(p.theme).map((f) => (
                      <FeatureLine feature={f} />
                    ))}
                  </ul>
                </div>
              </li>
            ))
          }
        </ol>

        <div class="mt-10 border-t border-line pt-5">
          <p class="label-mono text-fg-muted">Also in the editor</p>
          <p class="mt-3 text-sm text-fg-secondary">
            {editor.map((f, i) => (
              <>
                <span class="text-fg">{f.title}</span>
                {i < editor.length - 1 && <span class="text-fg-muted" aria-hidden="true"> · </span>}
              </>
            ))}
          </p>
          <a href="/create" class="mt-5 inline-block text-sm font-medium text-fg"><span class="link-quiet">Everything in Create</span> <span aria-hidden="true">→</span></a>
          <p class="mt-4 text-[0.8125rem] text-fg-muted">{trademarkNotice}</p>
        </div>
      </div>

      {
        media.writingDemo ? (
          <div class="lg:col-span-7 lg:col-start-6" data-reveal>
            <MediaSlot {...media.writingDemo} label="Riff Blocks in SixLine: a riff captured and built into a multitrack arrangement" />
          </div>
        ) : (
          <figure class="lg:col-span-7 lg:col-start-6" data-reveal style="--reveal-delay:120ms">
            <div class="relative rounded-2xl bg-warm-2 p-4 sm:p-8 lg:p-10">
              <Arrangement />
              <span class="label-mono absolute top-4 right-4 rounded-full border border-line bg-bg px-2.5 py-1 text-[0.625rem] text-accent-text sm:top-5 sm:right-5">
                Illustration
              </span>
            </div>
            <figcaption class="mt-4 text-sm text-fg-muted">
              Illustration of a riff growing into an arrangement. A real capture of Riff Blocks and multitrack editing will replace it.
            </figcaption>
          </figure>
        )
      }
    </div>
  </div>
</section>
