---
import Eyebrow from '~/components/ui/Eyebrow.astro';
import Logbook from '~/components/ui/Logbook.astro';
---

<section id="development" class="grain section-y overflow-hidden bg-warm-1" aria-labelledby="dev-title">
  <div class="container-content grid grid-cols-1 gap-14 lg:grid-cols-12 lg:gap-12">
    <div class="lg:col-span-5" data-reveal>
      <Eyebrow index="05">In the open</Eyebrow>
      <h2 id="dev-title" class="mt-7 text-h1 tracking-display text-fg">Always getting better.</h2>
      <p class="mt-7 max-w-md text-lead text-fg-secondary">
        SixLine is made in the open, release by release. You’ll always be able to see what changed, what’s next and what isn’t
        finished yet — and tell us what you’d like to see.
      </p>
      <div class="mt-9 flex flex-col items-start gap-3 text-sm">
        <a href="/updates" class="link-quiet text-fg">Release notes and updates <span aria-hidden="true">→</span></a>
        <a href="/features#workbench" class="link-quiet text-fg-secondary">What’s on the workbench <span aria-hidden="true">→</span></a>
        <a href="/support" class="link-quiet text-fg-secondary">Report an issue or suggest an idea <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="lg:col-span-6 lg:col-start-7 lg:pt-3" data-reveal style="--reveal-delay:120ms">
      <Logbook />
    </div>
  </div>
</section>
