---
/**
 * Promise 2 — Master. Released capabilities (from `available` features) are
 * shown as fact; Practice Mode (in-development) is shown only as clearly
 * labelled "coming soon" previews. Nothing here implies that SixLine listens
 * to or grades the player's performance.
 */
import Eyebrow from '~/components/ui/Eyebrow.astro';
import TabStaff from '~/components/music/TabStaff.astro';
import { availableFeatures, comingSoonFeatures, groupMeta } from '~/data/features';
import { riff, riffAnswer } from '~/data/riffs';

const bars = [...riff, ...riffAnswer];
const now = availableFeatures('playback');
const soon = comingSoonFeatures('playback');
---

<section id="master" class="grain section-y overflow-hidden bg-warm-1" aria-labelledby="master-title">
  <div class="container-wide">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12" data-reveal>
      <div class="lg:col-span-12">
        <Eyebrow index="02">{groupMeta.playback.label}</Eyebrow>
        <h2 id="master-title" class="mt-7 text-display font-medium tracking-display text-fg">
          Don’t just learn the notes.<br /><span class="text-sage">Own them.</span>
        </h2>
      </div>
      <p class="max-w-xl text-lead text-fg-secondary lg:col-span-5 lg:col-start-8">{groupMeta.playback.intro}</p>
    </div>

    <!-- The practice console: a loop region the playhead sweeps twice, then stops -->
    <figure class="mt-16 lg:mt-20" data-reveal data-playback style="--reveal-delay:100ms">
      <div class="studio rounded-2xl border border-line bg-linear-to-b from-warm-2 to-warm-1 p-2 shadow-frame">
        <div class="rounded-xl bg-canvas px-3 pt-6 pb-4 sm:px-8 sm:pt-10">
          <div class="hidden md:block"><TabStaff bars={bars} barWidth={360} playhead loop={[1, 3]} passes={2} duration={4.2} /></div>
          <div class="hidden sm:block md:hidden"><TabStaff bars={riff} barWidth={360} playhead loop={[1, 2]} passes={2} duration={2.6} /></div>
          <div class="sm:hidden"><TabStaff bars={[riff[1]]} barWidth={380} playhead loop={[0, 1]} passes={2} duration={2.4} clef={false} /></div>
        </div>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-3 px-3 py-3 sm:px-5">
          <button
            type="button"
            class="inline-flex h-10 items-center gap-2.5 rounded-full bg-accent pr-4 pl-3 text-sm font-medium text-on-accent shadow-button transition-[background-color,transform] duration-(--duration-base) hover:bg-accent-hover active:translate-y-px"
            data-playback-trigger
            hidden
          >
            <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
              <path d="M11.5 5A5 5 0 1 0 12 8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
              <path d="M12.5 1.5V5H9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span data-playback-label>Loop the passage</span>
          </button>
          <p class="flex items-center gap-2 rounded-full border border-line px-3 py-1.5 font-mono text-[0.6875rem] text-fg-secondary">
            <span class="text-sage">A–B</span> Loop
          </p>
          <p class="flex items-center gap-2 rounded-full border border-line px-3 py-1.5 font-mono text-[0.6875rem] text-fg-secondary">
            <span class="text-sage">♩</span> 70% speed
          </p>
          <p class="label-mono ml-auto text-fg-muted">Illustration · no audio</p>
        </div>
      </div>
      <figcaption class="mt-4 text-sm text-fg-muted">
        An illustration drawn by this website: a difficult passage looped and slowed down. Real footage of SixLine will replace it.
      </figcaption>
    </figure>

    <!-- Available now -->
    <ul class="mt-16 grid grid-cols-1 gap-10 border-t border-line pt-10 md:grid-cols-3" data-reveal>
      {
        now.map((f) => (
          <li>
            <h3 class="text-h4 text-fg">{f.title}</h3>
            <p class="mt-2 text-sm text-fg-secondary">{f.description}</p>
          </li>
        ))
      }
    </ul>

    <!-- Practice Mode: coming soon, clearly labelled as previews -->
    {
      soon.length > 0 && (
        <div class="mt-16 rounded-2xl border border-dashed border-line p-6 sm:p-9" data-reveal>
          <div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-3">
            <div>
              <p class="label-mono flex items-center gap-2.5 text-accent-text">
                <span class="size-2 rounded-full border border-accent bg-accent-soft" aria-hidden="true" />
                Coming soon · Practice Mode
              </p>
              <h3 class="mt-4 text-h2 tracking-display text-fg">Practice with a plan.</h3>
            </div>
            <p class="max-w-md text-sm text-fg-secondary">
              Practice Mode isn’t released yet. These previews show what it’s being designed to do — the details may change before
              it ships.
            </p>
          </div>

          <ul class="mt-10 grid grid-cols-1 gap-5 md:grid-cols-3">
            {soon.map((f) => (
              <li class="flex flex-col rounded-xl bg-warm-2 p-6">
                <div class="flex h-20 items-center" aria-hidden="true">
                  {f.id === 'practice-targets' && (
                    <div class="w-full font-mono text-[0.6875rem] text-fg-muted">
                      <div class="flex justify-between"><span>♩ 84</span><span class="text-accent-text">Target ♩ 120</span></div>
                      <div class="mt-2.5 h-1.5 rounded-full bg-warm-3"><div class="h-full w-[58%] rounded-full bg-sage" /></div>
                      <p class="mt-2.5">Bars 2–3 · saved</p>
                    </div>
                  )}
                  {f.id === 'clean-reps' && (
                    <div class="font-mono text-[0.6875rem] text-fg-muted">
                      <div class="flex gap-2">
                        {[1, 1, 1, 0, 0].map((d) => <span class:list={['size-3.5 rounded-full', d ? 'bg-sage' : 'border border-line-strong']} />)}
                      </div>
                      <p class="mt-3">3 of 5 clean · then +4 bpm</p>
                    </div>
                  )}
                  {f.id === 'personal-bests' && (
                    <div class="flex w-full items-end gap-1.5">
                      {[38, 46, 44, 55, 62, 70].map((h, i) => (
                        <span class:list={['flex-1 rounded-t-sm', i === 5 ? 'bg-accent' : 'bg-warm-3']} style={`height:${h}px`} />
                      ))}
                    </div>
                  )}
                </div>
                <p class="label-mono mt-5 text-fg-muted">Preview</p>
                <h4 class="mt-2 text-h4 text-fg">{f.title}</h4>
                <p class="mt-2 text-sm text-fg-secondary">{f.description}</p>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</section>

<script>
  // Sweeps the loop region twice when first scrolled into view; the button replays it.
  // Reduced motion: no animation (the playhead rests in the loop) and no button.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  for (const fig of document.querySelectorAll<HTMLElement>('[data-playback]')) {
    const btn = fig.querySelector<HTMLButtonElement>('[data-playback-trigger]');
    const label = fig.querySelector('[data-playback-label]');
    if (reduce || !btn) continue;
    btn.hidden = false;
    const play = () => {
      fig.classList.remove('is-playing');
      void fig.offsetWidth; // restart CSS animations
      fig.classList.add('is-playing');
      if (label) label.textContent = 'Loop it again';
    };
    btn.addEventListener('click', play);
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          setTimeout(play, 700);
        }
      },
      { threshold: 0.6 },
    );
    io.observe(fig);
  }
</script>
