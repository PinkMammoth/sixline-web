---
import Eyebrow from '~/components/ui/Eyebrow.astro';
import TabStaff from '~/components/music/TabStaff.astro';
import { riff, riffAnswer } from '~/data/riffs';

const bars = [...riff, ...riffAnswer];
---

<section id="playback" class="grain section-y overflow-hidden bg-warm-1" aria-labelledby="playback-title">
  <div class="container-wide">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:items-end" data-reveal>
      <div class="lg:col-span-8">
        <Eyebrow index="02">Play</Eyebrow>
        <h2 id="playback-title" class="mt-7 text-display font-medium tracking-display text-fg">
          Hear it back.<br /><span class="text-sage">Then play along.</span>
        </h2>
      </div>
      <p class="text-lead text-fg-secondary lg:col-span-4 lg:pb-3">
        SixLine plays back exactly what you’ve written, so you can check a part by ear, hear how the tracks sit together — and
        then pick up your guitar.
      </p>
    </div>

    <!-- The "console": a dark canvas with a playhead the visitor can replay -->
    <figure class="mt-16 lg:mt-20" data-reveal data-playback style="--reveal-delay:100ms">
      <div class="studio rounded-2xl border border-line bg-linear-to-b from-warm-2 to-warm-1 p-2 shadow-frame">
        <div class="rounded-xl bg-canvas px-3 pt-6 pb-4 sm:px-8 sm:pt-10">
          <div class="hidden md:block"><TabStaff bars={bars} playhead duration={6.4} barWidth={360} /></div>
          <div class="hidden sm:block md:hidden"><TabStaff bars={riff} playhead duration={3.4} barWidth={360} /></div>
          <div class="sm:hidden"><TabStaff bars={[riff[0]]} playhead duration={2} barWidth={380} /></div>
        </div>
        <div class="flex flex-wrap items-center gap-x-5 gap-y-3 px-3 py-3 sm:px-5">
          <button
            type="button"
            class="inline-flex h-10 items-center gap-2.5 rounded-full bg-accent pr-4 pl-3 text-sm font-medium text-on-accent shadow-button transition-[background-color,transform] duration-(--duration-base) hover:bg-accent-hover active:translate-y-px"
            data-playback-trigger
            hidden
          >
            <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 1.2v9.6L10.5 6z" fill="currentColor" /></svg>
            <span data-playback-label>Play the riff</span>
          </button>
          <p class="label-mono text-fg-muted">Visual demo · no audio</p>
          <p class="ml-auto hidden font-mono text-[0.6875rem] text-fg-muted sm:block">Guitar · Standard tuning · ♩ = 92</p>
        </div>
      </div>
      <figcaption class="mt-4 text-sm text-fg-muted">
        An illustration of playback, drawn by this website. Fret numbers light up as the playhead passes.
      </figcaption>
    </figure>

    <div class="mt-16 grid grid-cols-1 gap-10 border-t border-line pt-10 md:grid-cols-3" data-reveal>
      <div>
        <h3 class="text-h4 text-fg">Every track, every bar</h3>
        <p class="mt-2 text-sm text-fg-secondary">Play the whole arrangement back to hear what you’ve written, exactly as written.</p>
      </div>
      <div>
        <h3 class="text-h4 text-fg">Learn it by ear, then by hand</h3>
        <p class="mt-2 text-sm text-fg-secondary">Listen while you read the tab, then play along with parts you’ve imported or written.</p>
      </div>
      <div>
        <h3 class="text-h4 text-fg">More practice tools on the way</h3>
        <p class="mt-2 text-sm text-fg-secondary">
          Tempo control, looping and a metronome are being checked for the beta.{' '}
          <a href="/features#workbench" class="link-quiet text-fg">See the workbench</a>.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  // Plays the playhead once when first scrolled into view; the button replays it.
  // Reduced motion: no animation (the playhead rests in place) and no button.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  for (const fig of document.querySelectorAll<HTMLElement>('[data-playback]')) {
    const btn = fig.querySelector<HTMLButtonElement>('[data-playback-trigger]');
    const label = fig.querySelector('[data-playback-label]');
    if (reduce || !btn) continue;
    btn.hidden = false;
    const play = () => {
      fig.classList.remove('is-playing');
      void fig.offsetWidth; // restart CSS animations
      fig.classList.add('is-playing');
      if (label) label.textContent = 'Play again';
    };
    btn.addEventListener('click', play);
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          setTimeout(play, 700);
        }
      },
      { threshold: 0.6 },
    );
    io.observe(fig);
  }
</script>
