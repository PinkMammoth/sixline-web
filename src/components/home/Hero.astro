---
import Button from '~/components/ui/Button.astro';
import ProductFrame from '~/components/ui/ProductFrame.astro';
import TabSheet from '~/components/music/TabSheet.astro';
import { formatPrice, pricing, site } from '~/data/site';
---

<section class="grain relative overflow-hidden pt-12 pb-16 sm:pt-16 lg:pt-20 lg:pb-20" aria-labelledby="hero-title">
  <!-- Studio light: two very soft pools of warmth -->
  <div
    class="pointer-events-none absolute -top-40 right-[-10%] h-[44rem] w-[44rem] rounded-full bg-[radial-gradient(closest-side,var(--sl-glow-amber),transparent)]"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute top-[30rem] -left-40 h-[36rem] w-[36rem] rounded-full bg-[radial-gradient(closest-side,var(--sl-glow-sage),transparent)]"
    aria-hidden="true"
  >
  </div>

  <div class="container-wide relative grid grid-cols-1 gap-12 lg:grid-cols-12 lg:items-center lg:gap-10">
    <div class="lg:col-span-6">
      <p class="label-mono flex items-center gap-3 text-fg-muted">
        <span class="flex gap-1" aria-hidden="true">
          <span class="size-1.5 rounded-full bg-accent"></span>
          <span class="size-1.5 rounded-full bg-accent"></span>
          <span class="size-1.5 rounded-full bg-accent"></span>
        </span>
        <span>Practice &amp; composition for guitarists</span>
      </p>
      <h1 id="hero-title" class="mt-7 text-[clamp(3rem,1.5rem+4.6vw,5.75rem)] leading-[0.94] font-medium tracking-display text-fg">
        Learn it.<br />
        Master it.<br />
        <span class="text-fg-secondary">Make it yours.</span>
      </h1>
      <p class="mt-8 max-w-xl text-lead text-fg-secondary">
        Import a song you love, tackle its toughest passages and turn deliberate practice into real progress. When
        inspiration strikes, write and arrange music of your own.
      </p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
        <Button href="#practice" size="lg" arrow>See how practice works</Button>
        <Button href="#create" variant="secondary" size="lg">Explore Create</Button>
      </div>
      <p class="label-mono mt-8 text-fg-muted">
        <span class="text-fg-secondary">Desktop app</span> · {site.platformLabel} · Commercial beta coming soon
      </p>
      <p class="mt-2 text-sm text-fg-muted">
        {pricing.trialDays}-day free trial planned, then one payment of {formatPrice(pricing.beta.price)}, with every update included.
      </p>
    </div>

    <div class="lg:col-span-6">
      <ProductFrame
        priority
        title="Untitled riff — SixLine"
        aspect="16 / 11"
        mobileAspect="4 / 3.6"
        placeholderNote="Real capture coming: a song opening in Practice Mode"
        labelPosition="bottom"
      >
        <TabSheet compact />
      </ProductFrame>
    </div>
  </div>
</section>
