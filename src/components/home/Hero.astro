---
import Button from '~/components/ui/Button.astro';
import ProductFrame from '~/components/ui/ProductFrame.astro';
import TabSheet from '~/components/music/TabSheet.astro';
import { formatPrice, pricing, site, trialHref } from '~/data/site';
---

<section class="grain relative overflow-hidden pt-14 pb-24 sm:pt-20 lg:pt-24 lg:pb-32" aria-labelledby="hero-title">
  <!-- Studio light: two very soft pools of warmth -->
  <div
    class="pointer-events-none absolute -top-40 right-[-10%] h-[44rem] w-[44rem] rounded-full bg-[radial-gradient(closest-side,var(--sl-glow-amber),transparent)]"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute top-[38rem] -left-40 h-[36rem] w-[36rem] rounded-full bg-[radial-gradient(closest-side,var(--sl-glow-sage),transparent)]"
    aria-hidden="true"
  >
  </div>

  <div class="container-wide relative">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:items-end lg:gap-8">
      <div class="lg:col-span-7">
        <p class="label-mono flex items-center gap-3 text-fg-muted">
          <span class="flex gap-1" aria-hidden="true">
            <span class="size-1.5 rounded-full bg-accent"></span>
            <span class="size-1.5 rounded-full bg-accent"></span>
            <span class="size-1.5 rounded-full bg-accent"></span>
          </span>
          <span>Tab &amp; notation editor<span class="hidden sm:inline"> · {site.platformLabel}</span></span>
        </p>
        <h1 id="hero-title" class="mt-7 text-display font-medium tracking-display text-fg">
          Write music.<br />
          <span class="text-fg-secondary">Master it.</span>
        </h1>
      </div>

      <div class="lg:col-span-5 lg:pb-3">
        <p class="max-w-md text-lead text-fg-secondary">
          A modern guitar tab editor built for writing music, developing ideas and mastering what you play.
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
          <Button href="/features" size="lg" arrow>Explore SixLine</Button>
          <Button href={trialHref} variant="secondary" size="lg" pending="Coming soon">Try SixLine free</Button>
        </div>
        <p class="mt-5 text-sm text-fg-muted">
          <span class="text-fg-secondary">Public beta coming soon.</span> Free trial, then one payment of {formatPrice(pricing.beta.price)} — every update included.
        </p>
      </div>
    </div>

    <!-- Product showcase, resting on six strings -->
    <div class="relative mt-16 lg:mt-24">
      <div class="pointer-events-none absolute inset-x-[-50vw] top-[46%] hidden sm:block" aria-hidden="true">
        <div class="mx-auto flex max-w-none flex-col gap-[13px] opacity-[0.16]">
          {[0, 1, 2, 3, 4, 5].map(() => <span class="block h-[1.5px] bg-fg" />)}
        </div>
      </div>
      <ProductFrame class="relative" priority title="Untitled riff — SixLine" aspect="16 / 9.5" mobileAspect="4 / 3.6">
        <TabSheet />
      </ProductFrame>
    </div>
  </div>
</section>
