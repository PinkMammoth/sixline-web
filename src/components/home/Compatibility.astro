---
import Eyebrow from '~/components/ui/Eyebrow.astro';
import { confirmedFormats, trademarkNotice } from '~/data/features';
---

<section id="compatibility" class="grain section-y overflow-hidden" aria-labelledby="compat-title">
  <div class="container-wide grid grid-cols-1 gap-14 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-5" data-reveal>
      <Eyebrow index="03">Import</Eyebrow>
      <h2 id="compat-title" class="mt-7 text-h1 tracking-display text-fg">Bring your existing tabs with you.</h2>
      <p class="mt-7 max-w-md text-lead text-fg-secondary">
        Years of transcriptions and half-finished ideas shouldn’t stay locked in another app. Open them in SixLine and keep going.
      </p>
    </div>

    <!-- Formats as tape-box labels: ivory card, ruled header, big type -->
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:col-span-7" data-reveal style="--reveal-delay:120ms">
      {
        confirmedFormats.map((f, i) => (
          <article class="paper flex flex-col overflow-hidden rounded-xl shadow-panel">
            <div class="flex items-center justify-between border-b-2 border-ink/80 px-5 py-2.5">
              <span class="label-mono text-[0.6875rem] text-fg-muted">Format 0{i + 1}</span>
              <span class="label-mono text-[0.6875rem] text-accent-text">{f.direction}</span>
            </div>
            <div class="flex flex-1 flex-col px-5 pt-10 pb-6">
              <h3 class="font-display text-[clamp(2.25rem,1.5rem+2.4vw,3.5rem)] leading-none font-medium tracking-display text-fg">
                {f.name}
              </h3>
              <p class="mt-auto pt-10 text-sm text-fg-secondary">{f.description}</p>
            </div>
            <div class="flex gap-1 px-5 pb-5" aria-hidden="true">
              {[0, 1, 2, 3, 4, 5].map(() => (
                <span class="h-px flex-1 bg-[var(--sl-border-strong)] opacity-50" />
              ))}
            </div>
          </article>
        ))
      }
      <p class="text-sm text-fg-muted sm:col-span-2">
        The exact Guitar Pro versions supported, MIDI export, printing and PDF export will be confirmed before the public beta.
      </p>
      <p class="text-[0.8125rem] text-fg-muted sm:col-span-2">{trademarkNotice}</p>
    </div>
  </div>
</section>
