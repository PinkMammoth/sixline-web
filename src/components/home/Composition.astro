---
import Eyebrow from '~/components/ui/Eyebrow.astro';
import Arrangement from '~/components/music/Arrangement.astro';
import MediaSlot from '~/components/ui/MediaSlot.astro';
import { availableFeatures } from '~/data/features';
import { media } from '~/data/site';

const items = availableFeatures('writing');
---

<section id="writing" class="paper grain section-y overflow-hidden" aria-labelledby="writing-title">
  <div class="container-wide">
    <div data-reveal>
      <Eyebrow index="01">Write</Eyebrow>
      <h2 id="writing-title" class="mt-7 max-w-[15ch] text-display font-medium tracking-display text-fg">
        From the first riff to the full arrangement.
      </h2>
    </div>

    <div class="mt-16 grid grid-cols-1 gap-14 lg:mt-20 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-4 lg:pt-4" data-reveal>
        <p class="text-lead text-fg-secondary">
          Catch the idea while it’s fresh, then build it out. Tab and notation side by side, with each part on its own track — so a
          riff can grow into a song without leaving the page.
        </p>
        <ol class="mt-12 space-y-10">
          {
            items.map((f, i) => (
              <li class="grid grid-cols-[2.5rem_1fr] gap-x-4 border-t border-line pt-6">
                <span class="font-mono text-sm text-accent-text">0{i + 1}</span>
                <div>
                  <h3 class="text-h3 text-fg">{f.title}</h3>
                  <p class="mt-2 text-fg-secondary">{f.description}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      {media.writingDemo ? (
        <div class="lg:col-span-7 lg:col-start-6" data-reveal>
          <MediaSlot {...media.writingDemo} label="A riff being written and built into a multi-track arrangement in SixLine" />
        </div>
      ) : (
      <figure class="lg:col-span-7 lg:col-start-6" data-reveal style="--reveal-delay:120ms">
        <div class="relative rounded-2xl bg-warm-1 p-4 sm:p-8 lg:p-10">
          <Arrangement />
          <span class="label-mono absolute top-4 right-4 rounded-full border border-line bg-bg px-2.5 py-1 text-[0.625rem] text-accent-text sm:top-5 sm:right-5">
            Illustration
          </span>
        </div>
        <figcaption class="mt-4 text-sm text-fg-muted">
          Illustration of the workflow. A short screen recording of the real app will take its place.
        </figcaption>
      </figure>
      )}
    </div>
  </div>
</section>
